local processTool

local function unhookTool(tool)
	local list = hooked[tool]
	if not list then return end
	for _, c in ipairs(list) do pcall(function() c:Disconnect() end) end
	hooked[tool] = nil
	bursting[tool] = nil
end

local function hookTool(tool)
	if hooked[tool] then return end
	local list = {}
	list[1] = tool.Activated:Connect(function()
		lastActivate = os.clock()
		forceBurst(tool)
	end)
	list[2] = tool.Equipped:Connect(function()
		if CONFIG.Enabled then task.defer(function() processTool(tool) end) end
	end)
	list[3] = tool.Unequipped:Connect(function()
		restoreTool(tool)
	end)
	hooked[tool] = list
	for _, c in ipairs(list) do table.insert(connections, c) end
end

processTool = function(tool)
	hookTool(tool)
	if tool.Parent ~= player.Character then return end
	for _, d in ipairs(tool:GetDescendants()) do
		if d:IsA("BasePart") and not d:GetAttribute("HBX_Clone") then expandPart(d) end
	end
end

local function scan()
	local ch = player.Character
	for part, d in pairs(parts) do
		if not part:IsDescendantOf(game) then
			if d.lock then pcall(function() d.lock:Disconnect() end) end
			parts[part] = nil
		else
			local tool = part:FindFirstAncestorOfClass("Tool")
			if tool and tool.Parent ~= ch then restorePart(part, d) end
		end
	end
	local bp = player:FindFirstChildOfClass("Backpack")
	if bp then
		for _, t in ipairs(bp:GetChildren()) do
			if t:IsA("Tool") then hookTool(t) end
		end
	end
	if ch then
		for _, t in ipairs(ch:GetChildren()) do
			if t:IsA("Tool") then processTool(t) end
		end
	end

	for tool in pairs(hooked) do
		if not tool:IsDescendantOf(game) then
			unhookTool(tool)
		elseif tool.Parent == workspace then
			for _, p in ipairs(tool:GetDescendants()) do
				if p:IsA("BasePart") and not p:GetAttribute("HBX_Clone") then
					if parts[p] then restorePart(p, parts[p]) end
					if CONFIG.Throwables and os.clock() - lastActivate <= K.PROJECTILE_WINDOW + 1 then
						registerProjectile(p, 10)
					end
				end
			end
		end
	end
end

local function enforce()
	for part, d in pairs(parts) do
		if part.Parent then
			local sz = targetSize(part:FindFirstAncestorOfClass("Tool"))
			if part.Size ~= sz then
				d.applying = true
				pcall(function() part.Size = sz end)
				d.applying = false
			end
		end
	end
end

K.GUN_WORDS = {
	"gun", "muzzle", "barrel", "shoot", "ammo", "bullet", "pistol", "rifle", "shotgun", "sniper", "smg",
	"revolver", "reload", "magazine", "glock", "firepoint", "fireport",
}
local gunCache = setmetatable({}, { __mode = "k" })

local function nameHasGunWord(name)
	name = string.lower(name)
	for _, w in ipairs(K.GUN_WORDS) do
		if string.find(name, w, 1, true) then return true end
	end
	return false
end

local function looksLikeGun(tool)
	local c = gunCache[tool]
	if c and (c.r or os.clock() - c.t < 3) then return c.r end
	local result = nameHasGunWord(tool.Name)
	if not result then
		local n = 0
		for _, d in ipairs(tool:GetDescendants()) do
			if nameHasGunWord(d.Name) then
				result = true
				break
			end
			n = n + 1
			if n > 300 then break end
		end
	end
	gunCache[tool] = { r = result, t = os.clock() }
	return result
end

local function attackRecent()
	return os.clock() - lastActivate < math.max(1, CONFIG.BurstTime + 0.5)
end

local function enemyBoxActive()
	local m = CONFIG.TargetMode
	if m == "On" then return true end
	if m == "Off" or not CONFIG.Enabled then return false end
	if m == "Auto" and attackRecent() then return true end
	local ch = player.Character
	local tool = ch and ch:FindFirstChildOfClass("Tool")
	if not tool then return false end
	return m == "Tool" or looksLikeGun(tool)
end

K.TARGET_RANGE = 500

local function enemyBoxSize(model, dist)
	local base = math.clamp(CONFIG.TargetSize, 2, 500)
	local w = base
	if CONFIG.NPCSize > 0 and not Players:GetPlayerFromCharacter(model) then w = math.clamp(CONFIG.NPCSize, 2, 500) end
	local h = w
	if CONFIG.TargetHeight > 0 then h = w * math.clamp(CONFIG.TargetHeight, 2, 500) / base end
	if CONFIG.DistScale then
		local k = math.clamp(0.6 + dist / 50, 0.6, 3)
		w, h = w * k, h * k
		w, h = math.floor(w / 2 + 0.5) * 2, math.floor(h / 2 + 0.5) * 2
	end
	return Vector3.new(math.clamp(w, 2, 500), math.clamp(h, 2, 500), math.clamp(w, 2, 500))
end

-- Which enemy parts get the big hitbox.
-- Head / Torso / Root (HumanoidRootPart) = just that part. Whole = the entire body (root, head, torso, and with Full body every limb too).
local function boxParts(model)
	local list = {}
	local function add(p)
		if p and p:IsA("BasePart") and not p:GetAttribute("HBX_Clone") and not table.find(list, p) and #list < 20 then
			list[#list + 1] = p
		end
	end
	local nm = CONFIG.BodyPart
	if nm == "Head" then
		add(model:FindFirstChild("Head"))
	elseif nm == "Torso" then
		add(model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso"))
	elseif nm == "Root" then
		add(model:FindFirstChild("HumanoidRootPart"))
	else
		for _, n2 in ipairs(K.BODY_ORDER.Whole) do add(model:FindFirstChild(n2)) end
		if CONFIG.FullBody then
			for _, c in ipairs(model:GetChildren()) do add(c) end
		end
	end
	if #list == 0 then add(modelRoot(model)) end
	return list
end

local function isOwnModel(model, ch)
	if Players:GetPlayerFromCharacter(model) == player then return true end
	if ch and (model:IsDescendantOf(ch) or ch:IsDescendantOf(model)) then return true end
	return false
end

local function restoreTarget(root, d)
	if d.adorn then pcall(function() d.adorn:Destroy() end) end
	pcall(function()
		root.Size = d.Size
		root.CanCollide = d.CanCollide
		root.CanQuery = d.CanQuery
		root.CanTouch = d.CanTouch
		if d.Massless ~= nil then root.Massless = d.Massless end
		if d.Shape ~= nil then root.Shape = d.Shape end
	end)
	tparts[root] = nil
end

local function restoreTargets()
	for root, d in pairs(tparts) do restoreTarget(root, d) end
	tcount = 0
end

local function updateTargets()
	local ch = player.Character
	local myRoot = ch and ch:FindFirstChild("HumanoidRootPart")
	local boxOn = enemyBoxActive()
	local teleOn = CONFIG.TeleportMode and attackRecent()
	if not ((boxOn or teleOn) and myRoot) then
		if next(tparts) then restoreTargets() end
		if next(teleEnemy) then H.teleportRestoreAll(teleEnemy) end
		tcount = 0
		return
	end
	local seen, teleSeen, n = {}, {}, 0
	local cam = workspace.CurrentCamera
	local camPos = cam and cam.CFrame.Position
	for hum in pairs(humanoids) do
		local model = hum.Parent
		if model and model ~= ch and not isOwnModel(model, ch) and hum:IsDescendantOf(workspace) and hum.Health > 0 and passesFilter(model) and matchesPick(model) then
			local hrp = modelRoot(model)
			local dist = hrp and (hrp.Position - myRoot.Position).Magnitude
			if dist and dist <= K.TARGET_RANGE then
				local tlist = H.teleParts(model, hrp)
				if CONFIG.TeleportMode and not Players:GetPlayerFromCharacter(model) then
					-- Anchored NPCs (quest givers, shopkeepers, dummies) are left completely alone unless "Anchored NPCs" is on.
					if hrp.Anchored and not CONFIG.TeleportAnchored then continue end
					-- Teleport hit: only while you are actually attacking (equipping a tool does nothing), and only the
					-- chosen part (root part or legs) moves. Outside an attack it is left alone and put back.
					if teleOn then
						for _, tpart in ipairs(tlist) do
							teleSeen[tpart] = true
							H.teleportSet(teleEnemy, tpart)
							if tparts[tpart] then restoreTarget(tpart, tparts[tpart]) end
						end
						n = n + 1
					end
					continue
				end
				if not boxOn then continue end
				local sz = H.shapeSize(enemyBoxSize(model, dist))
				local any = false
				for _, root in ipairs(boxParts(model)) do
					any = true
					seen[root] = true
					local d = tparts[root]
					if not d then
						d = { Size = root.Size, CanCollide = root.CanCollide, CanQuery = root.CanQuery, CanTouch = root.CanTouch, Massless = root.Massless, Shape = root:IsA("Part") and root.Shape or nil }
						tparts[root] = d
					end
					-- Keep outside: never let the box grow past your body / camera, because rays and touches that start
					-- inside a part do not register. The box stays as big as it can while its surface stays outside you.
					local psz = sz
					if CONFIG.KeepOutside then
						local pd = (root.Position - myRoot.Position).Magnitude
						if camPos then pd = math.min(pd, (root.Position - camPos).Magnitude) end
						local nat = d.Size
						local cap = math.max(math.floor(2 * (pd - K.KEEP_MARGIN)), math.max(nat.X, nat.Y, nat.Z))
						psz = Vector3.new(math.min(sz.X, cap), math.min(sz.Y, cap), math.min(sz.Z, cap))
					end
					psz = Vector3.new(math.min(psz.X, 2048), math.min(psz.Y, 2048), math.min(psz.Z, 2048))
					if root.Size ~= psz then pcall(function() root.Size = psz end) end
					if root.CanCollide or not root.CanQuery or not root.CanTouch or not root.Massless then
						pcall(function()
							root.CanCollide = false
							root.CanQuery = true
							root.CanTouch = true
							root.Massless = true
						end)
					end
					if root:IsA("Part") then
						local want = (CONFIG.HitShape == "Sphere") and Enum.PartType.Ball or d.Shape
						if want and root.Shape ~= want then pcall(function() root.Shape = want end) end
					end
					if CONFIG.Visual == "Shown" then
						H.syncAdorn(d, root, psz, H.pickColor(CONFIG.EnemyColor, model), "HBX_EnemyBox")
					elseif d.adorn then
						pcall(function() d.adorn:Destroy() end)
						d.adorn = nil
					end
				end
				if any then n = n + 1 end
			end
		end
	end
	for root, d in pairs(tparts) do
		if not seen[root] then restoreTarget(root, d) end
	end
	for part in pairs(teleEnemy) do
		if not teleSeen[part] then H.teleportRestore(teleEnemy, part) end
	end
	tcount = n
end

