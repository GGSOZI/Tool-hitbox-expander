function H.updateEsp()
	local want = CONFIG.EspName or CONFIG.EspDist or CONFIG.EspHealth or CONFIG.Tracers
	if not want or not alive then
		if next(esp) then H.clearEsp() end
		return
	end
	if not (gui and gui.Parent) then return end
	if not (espGui and espGui.Parent) then
		espGui = Instance.new("ScreenGui")
		espGui.Name = "HBX_ESP"
		espGui.ResetOnSpawn = false
		espGui.IgnoreGuiInset = true
		espGui.DisplayOrder = 5
		espGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		espGui.Parent = gui.Parent
	end
	local cam = workspace.CurrentCamera
	local ch = player.Character
	local myRoot = ch and ch:FindFirstChild("HumanoidRootPart")
	if not (cam and myRoot) then return end
	local vs = cam.ViewportSize
	local list = {}
	for hum in pairs(humanoids) do
		local model = hum.Parent
		if model and model ~= ch and hum.Health > 0 and hum:IsDescendantOf(workspace) and not isOwnModel(model, ch) and passesFilter(model) then
			local root = modelRoot(model)
			if root then
				local dist = (root.Position - myRoot.Position).Magnitude
				if dist <= K.ESP_RANGE then list[#list + 1] = { model = model, hum = hum, root = root, dist = dist } end
			end
		end
	end
	if #list > K.ESP_MAX then
		table.sort(list, function(a, b) return a.dist < b.dist end)
		for i = #list, K.ESP_MAX + 1, -1 do list[i] = nil end
	end
	local origin
	if CONFIG.TracerFrom == "Center" then
		origin = Vector2.new(vs.X / 2, vs.Y / 2)
	elseif CONFIG.TracerFrom == "Mouse" then
		origin = UserInputService:GetMouseLocation()
	else
		origin = Vector2.new(vs.X / 2, vs.Y)
	end
	local seen = {}
	for _, it in ipairs(list) do
		local model = it.model
		seen[model] = true
		local e = esp[model]
		if not e then
			e = {}
			esp[model] = e
		end
		local col = H.espColor(model, it.hum)
		if CONFIG.EspName or CONFIG.EspDist or CONFIG.EspHealth then
			local head = model:FindFirstChild("Head")
			local topPos = ((head and head:IsA("BasePart")) and head.Position or it.root.Position) + Vector3.new(0, 2, 0)
			local p3 = cam:WorldToViewportPoint(topPos)
			if not (e.label and e.label.Parent) then
				local l = Instance.new("TextLabel")
				l.AnchorPoint = Vector2.new(0.5, 1)
				l.Size = UDim2.fromOffset(240, 16)
				l.BackgroundTransparency = 1
				l.Font = Enum.Font.GothamBold
				l.TextSize = 12
				l.TextStrokeTransparency = 0.35
				l.TextStrokeColor3 = Color3.new(0, 0, 0)
				l.Parent = espGui
				e.label = l
			end
			local bits = {}
			if CONFIG.EspName then
				local plr = Players:GetPlayerFromCharacter(model)
				bits[#bits + 1] = plr and plr.DisplayName or model.Name
			end
			if CONFIG.EspDist then bits[#bits + 1] = math.floor(it.dist + 0.5) .. " studs" end
			if CONFIG.EspHealth then bits[#bits + 1] = math.floor(it.hum.Health + 0.5) .. "/" .. math.floor(it.hum.MaxHealth + 0.5) .. " HP" end
			e.label.Text = table.concat(bits, "  |  ")
			e.label.TextColor3 = col
			e.label.Visible = p3.Z > 0
			e.label.Position = UDim2.fromOffset(p3.X, p3.Y)
		elseif e.label then
			e.label:Destroy()
			e.label = nil
		end
		if CONFIG.Tracers then
			local pc = cam:WorldToViewportPoint(it.root.Position)
			if not (e.line and e.line.Parent) then
				local f = Instance.new("Frame")
				f.AnchorPoint = Vector2.new(0.5, 0.5)
				f.BorderSizePixel = 0
				f.BackgroundTransparency = 0.15
				f.Parent = espGui
				e.line = f
			end
			e.line.Visible = pc.Z > 0
			if pc.Z > 0 then
				local to = Vector2.new(pc.X, pc.Y)
				local d = to - origin
				e.line.Size = UDim2.fromOffset(d.Magnitude, 1.5)
				e.line.Position = UDim2.fromOffset((origin.X + to.X) / 2, (origin.Y + to.Y) / 2)
				e.line.Rotation = math.deg(math.atan2(d.Y, d.X))
				e.line.BackgroundColor3 = col
			end
		elseif e.line then
			e.line:Destroy()
			e.line = nil
		end
	end
	for m, e in pairs(esp) do
		if not seen[m] then H.dropEsp(m, e) end
	end
end
