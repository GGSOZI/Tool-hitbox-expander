end

local function copyVal(v)
	if type(v) == "table" then
		local t = {}
		for a, b in pairs(v) do t[a] = copyVal(b) end
		return t
	end
	return v
end

local function savePreset(i)
	local snap = {}
	for _, k in ipairs(PRESET_KEYS) do snap[k] = copyVal(CONFIG[k]) end
	CONFIG.Presets[tostring(i)] = snap
	showStatus("Saved preset " .. i, 3)
	refreshUI()
end

local function loadPreset(i)
	local snap = CONFIG.Presets[tostring(i)]
	if type(snap) ~= "table" then
		showStatus("Preset " .. i .. " is empty. Press Save " .. i .. " first.", 4)
		return
	end
	for _, k in ipairs(PRESET_KEYS) do
		if snap[k] ~= nil and type(snap[k]) == type(CONFIG[k]) then CONFIG[k] = copyVal(snap[k]) end
	end
	sanitizeConfig()
	restoreTargets()
	applySim(CONFIG.SimRadius)
	if CONFIG.Enabled then scan() end
	showStatus("Loaded preset " .. i, 3)
	refreshUI()
end

local function lockTarget()
	if lockedModel then
		lockedModel = nil
		showStatus("Target lock: off", 3)
		refreshUI()
		return
	end
	local cam = workspace.CurrentCamera
	local ch = player.Character
	if not cam then return end
	local best, bestDot = nil, 0.8
	for hum in pairs(humanoids) do
		local model = hum.Parent
		if model and model ~= ch and hum.Health > 0 and hum:IsDescendantOf(workspace) and passesFilter(model) then
			local root = model:FindFirstChild("HumanoidRootPart")
			if root then
				local v = root.Position - cam.CFrame.Position
				if v.Magnitude > 1 and v.Magnitude < 500 then
					local d = cam.CFrame.LookVector:Dot(v.Unit)
					if d > bestDot then best, bestDot = model, d end
				end
			end
		end
	end
	lockedModel = best
	showStatus(best and ("Target locked: " .. best.Name) or "No enemy near your crosshair to lock", 3)
	refreshUI()
end

