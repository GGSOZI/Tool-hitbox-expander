-- BREAKABLE OBJECTS: expand their hitbox and touch them (crates, barrels, doors, ore, anything m1 can break)
local oparts = {}
local objParams = OverlapParams.new()
local aimParams = RaycastParams.new()

function H.objKeywords()
	local list = {}
	for w in CONFIG.ObjKeywords:lower():gmatch("[^,%s]+") do list[#list + 1] = w end
	return list
end
function H.nameHit(inst, kws)
	local n = inst.Name:lower()
	for _, k in ipairs(kws) do
		if n:find(k, 1, true) then return true end
	end
	return false
end
function H.breakSignal(inst)
	local okA, attrs = pcall(function() return inst:GetAttributes() end)
	if okA and attrs then
		for k in pairs(attrs) do
			local lk = k:lower()
			if lk:find("health") or lk == "hp" or lk:find("durab") or lk:find("break") or lk:find("destroy") then return true end
		end
	end
	local okT, tags = pcall(function() return game:GetService("CollectionService"):GetTags(inst) end)
	if okT and tags then
		for _, t in ipairs(tags) do
			local lt = t:lower()
			if lt:find("break") or lt:find("destruct") or lt:find("destroy") or lt:find("health") then return true end
		end
	end
	for _, c in ipairs(inst:GetChildren()) do
		if c:IsA("ValueBase") then
			local ln = c.Name:lower()
			if ln:find("health") or ln == "hp" or ln:find("durab") then return true end
		end
	end
	return false
end

-- parts that are a person, an npc, a tool, huge map geometry or the ground are never objects
function H.objectBase(p, myRoot, cache)
	if not p:IsA("BasePart") or p.ClassName == "Terrain" then return false end
	local d = oparts[p]
	local nat = d and d.Size or p.Size
	if math.max(nat.X, nat.Y, nat.Z) > K.OBJ_MAX_NATURAL then return false end
	if p.Position.Y + nat.Y / 2 < myRoot.Position.Y - 2.8 then return false end
	local model = p:FindFirstAncestorOfClass("Model")
	if model then
		local c = cache[model]
		if c == nil then
			c = model:FindFirstChildOfClass("Humanoid") ~= nil or #model:GetChildren() > 40
			cache[model] = c
		end
		if c then return false end
	end
	if p:FindFirstAncestorOfClass("Tool") or p:FindFirstAncestorOfClass("Accessory") then return false end
	return true
end

function H.aimedPart(myRoot, cache)
	local cam = workspace.CurrentCamera
	if not cam then return nil end
	local x, y
	if UserInputService.MouseEnabled then
		local m = UserInputService:GetMouseLocation()
		x, y = m.X, m.Y
	else
		x, y = cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2
	end
	local ray = cam:ViewportPointToRay(x, y)
	aimParams.FilterType = Enum.RaycastFilterType.Exclude
	aimParams.FilterDescendantsInstances = { player.Character }
	local ok, res = pcall(workspace.Raycast, workspace, ray.Origin, ray.Direction * 400, aimParams)
	if ok and res and res.Instance and H.objectBase(res.Instance, myRoot, cache) then return res.Instance end
	return nil
end

function H.refreshObjects()
	local ch = player.Character
	local myRoot = ch and ch:FindFirstChild("HumanoidRootPart")
	if not (CONFIG.Objects and CONFIG.Enabled and myRoot) then
		objects.list, objects.n = {}, 0
		return
	end
	local list = {}
	local cache, sigCache = {}, {}
	if CONFIG.ObjMode == "Aim" then
		local p = H.aimedPart(myRoot, cache)
		if p then list[1] = p end
	else
		objParams.FilterType = Enum.RaycastFilterType.Exclude
		objParams.FilterDescendantsInstances = { ch }
		objParams.MaxParts = 400
		local ok, found = pcall(workspace.GetPartBoundsInRadius, workspace, myRoot.Position, CONFIG.ObjRange, objParams)
		if ok and type(found) == "table" then
			local kws = H.objKeywords()
			for _, p in ipairs(found) do
				if H.objectBase(p, myRoot, cache) then
					local model = p:FindFirstAncestorOfClass("Model")
					local container = model or p
					local hit = H.nameHit(p, kws) or H.nameHit(container, kws)
					if not hit and CONFIG.ObjMode == "Auto" then
						local s = sigCache[container]
						if s == nil then
							s = H.breakSignal(container) or (container ~= p and H.breakSignal(p))
							sigCache[container] = s
						end
						hit = s
					end
					if hit then list[#list + 1] = p end
				end
			end
		end
	end
	local have = {}
	for _, p in ipairs(list) do have[p] = true end
	for p in pairs(pickedObjects) do
		if not have[p] and H.pickedValid(p) then
			list[#list + 1] = p
			have[p] = true
		end
	end
	local pos = myRoot.Position
	table.sort(list, function(a, b) return (a.Position - pos).Magnitude < (b.Position - pos).Magnitude end)
	for i = #list, 61, -1 do list[i] = nil end
	objects.list, objects.n = list, #list
end

function H.restoreObjPart(p, d)
	if d.adorn then pcall(function() d.adorn:Destroy() end) end
	pcall(function()
		p.Size = d.Size
		p.CanCollide = d.CanCollide
		p.CanQuery = d.CanQuery
		p.CanTouch = d.CanTouch
		if d.Shape ~= nil then p.Shape = d.Shape end
	end)
	oparts[p] = nil
end
function H.restoreObjects()
	for p, d in pairs(oparts) do H.restoreObjPart(p, d) end
end

function H.updateObjects()
	local active = CONFIG.Objects and CONFIG.Enabled and (CONFIG.ObjWhen == "Always" or attackRecent())
	if not active then
		if next(oparts) then H.restoreObjects() end
		if next(teleObj) then H.teleportRestoreAll(teleObj) end
		return
	end
	local ch = player.Character
	local myRoot = ch and ch:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end
	local cam = workspace.CurrentCamera
	local camPos = cam and cam.CFrame.Position
	local base = H.shapeSize(Vector3.new(CONFIG.ObjSize, CONFIG.ObjSize, CONFIG.ObjSize))
	local seen, teleSeen = {}, {}
	for _, p in ipairs(objects.list) do
		if p.Parent then
			seen[p] = true
			local d = oparts[p]
			if not d then
				d = { Size = p.Size, CanCollide = p.CanCollide, CanQuery = p.CanQuery, CanTouch = p.CanTouch, Shape = p:IsA("Part") and p.Shape or nil }
				oparts[p] = d
			end
			local psz = base
			if CONFIG.KeepOutside then
				local pd = (p.Position - myRoot.Position).Magnitude
				if camPos then pd = math.min(pd, (p.Position - camPos).Magnitude) end
				local nat = d.Size
				local cap = math.max(math.floor(2 * (pd - K.KEEP_MARGIN)), math.max(nat.X, nat.Y, nat.Z))
				psz = Vector3.new(math.min(base.X, cap), math.min(base.Y, cap), math.min(base.Z, cap))
			end
			psz = Vector3.new(math.min(math.max(psz.X, d.Size.X), 2048), math.min(math.max(psz.Y, d.Size.Y), 2048), math.min(math.max(psz.Z, d.Size.Z), 2048))
			if p.Size ~= psz then pcall(function() p.Size = psz end) end
			if p.CanCollide or not p.CanQuery or not p.CanTouch then
				pcall(function()
					p.CanCollide = false
					p.CanQuery = true
					p.CanTouch = true
				end)
			end
			if p:IsA("Part") then
				local want = (CONFIG.HitShape == "Sphere") and Enum.PartType.Ball or d.Shape
				if want and p.Shape ~= want then pcall(function() p.Shape = want end) end
			end
			if CONFIG.Visual == "Shown" then
				H.syncAdorn(d, p, psz, H.pickColor(CONFIG.ObjColor), "HBX_ObjBox")
			elseif d.adorn then
				pcall(function() d.adorn:Destroy() end)
				d.adorn = nil
			end
		end
	end
	for p, d in pairs(oparts) do
		if not seen[p] or not p.Parent then H.restoreObjPart(p, d) end
	end
	for p in pairs(teleObj) do
		if not teleSeen[p] then H.teleportRestore(teleObj, p) end
	end
end

-- RADAR
local radar = { frame = nil, dots = {}, corners = {}, pos = nil }
function H.ensureOverlay()
	if espGui and espGui.Parent then return true end
	if not (gui and gui.Parent) then return false end
	espGui = Instance.new("ScreenGui")
	espGui.Name = "HBX_ESP"
	espGui.ResetOnSpawn = false
	espGui.IgnoreGuiInset = true
	espGui.DisplayOrder = 5
	espGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	espGui.Parent = gui.Parent
	return true
end
function H.destroyRadar()
	if radar.frame then pcall(function() radar.frame:Destroy() end) end
	radar.frame, radar.dots, radar.corners, radar.stroke = nil, {}, {}, nil
end
function H.buildRadar()
	if not H.ensureOverlay() then return false end
	local sz = CONFIG.RadarSize
	local f = Instance.new("Frame")
