function H.frontCFrame(part, dist)
	local cam = workspace.CurrentCamera
	local ch = player.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	if not root then return nil end
	local look = (cam and cam.CFrame.LookVector) or root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.05 then flat = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z) end
	if flat.Magnitude < 0.05 then flat = Vector3.new(1, 0, 0) end
	flat = flat.Unit
	local pos = root.Position + flat * dist + Vector3.new(0, 1.5, 0)
	local origCF = part.CFrame
	return CFrame.new(pos) * (origCF - origCF.Position)
end
function H.teleParts(model, fallback)
	local names = { "HumanoidRootPart" }
	if CONFIG.TeleportPart == "Legs" then
		names = { "LeftUpperLeg", "RightUpperLeg", "Left Leg", "Right Leg" }
	end
	local list = {}
	for _, n in ipairs(names) do
		local p = model:FindFirstChild(n)
		if p and p:IsA("BasePart") then list[#list + 1] = p end
	end
	if #list == 0 and fallback then list[1] = fallback end
	return list
end
-- Moving one part of a rig normally drags the whole rig. Switching off the joints between it and the other body parts
-- lets just that one part move; the joints come back on when it is put back.
function H.detachJoints(part)
	local list = {}
	local model = part.Parent
	if not (model and model:IsA("Model")) then return list end
	for _, j in ipairs(model:GetDescendants()) do
		if (j:IsA("JointInstance") or j:IsA("WeldConstraint")) and j.Enabled then
			local a, b = j.Part0, j.Part1
			local other = (a == part and b) or (b == part and a) or nil
			if other and other.Parent == model then
				list[#list + 1] = j
				pcall(function() j.Enabled = false end)
			end
		end
	end
	return list
end
function H.teleportSet(tbl, part)
	local d = tbl[part]
	if not d then
		d = { cf = part.CFrame, anchored = part.Anchored, joints = H.detachJoints(part) }
		tbl[part] = d
	end
	local nc = H.frontCFrame(part, CONFIG.TeleportDist)
	if nc then
		pcall(function()
			part.CFrame = nc
			if not part.Anchored then
				part.AssemblyLinearVelocity = Vector3.zero
				part.AssemblyAngularVelocity = Vector3.zero
			end
		end)
	end
end
function H.teleportRestore(tbl, part)
	local d = tbl[part]
	if d then
		pcall(function() part.CFrame = d.cf end)
		for _, j in ipairs(d.joints or {}) do pcall(function() j.Enabled = true end) end
		tbl[part] = nil
	end
end
function H.teleportRestoreAll(tbl)
	for part in pairs(tbl) do H.teleportRestore(tbl, part) end
end
function H.teleportTick()
	if not CONFIG.TeleportMode then return end
	for part in pairs(teleEnemy) do
		if part.Parent then H.teleportSet(teleEnemy, part) else teleEnemy[part] = nil end
	end
	for part in pairs(teleObj) do
		if part.Parent then H.teleportSet(teleObj, part) else teleObj[part] = nil end
	end
end
function H.pickedValid(p)
	if not (p:IsA("BasePart") and p.Parent and p.ClassName ~= "Terrain") then return false end
	local model = p:FindFirstAncestorOfClass("Model")
	if model and model:FindFirstChildOfClass("Humanoid") then return false end
	return true
end
function H.pickedCount()
	local n = 0
	for p in pairs(pickedObjects) do
		if p.Parent then n = n + 1 else pickedObjects[p] = nil end
	end
	return n
end
function H.objectExtra(targets, center, radius)
	if not (CONFIG.Objects and CONFIG.ObjTouch) then return targets end
	local have = {}
	for _, t in ipairs(targets) do have[t] = true end
	local added = 0
	for _, p in ipairs(objects.list) do
		if not have[p] and p.Parent then
			if (p.Position - center).Magnitude <= radius + p.Size.Magnitude * 0.5 + 2 then
				targets[#targets + 1] = p
				added = added + 1
				if added >= 12 then break end
			end
		end
	end
	return targets
end
