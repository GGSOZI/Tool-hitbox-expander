local function restoreTarget(root, d)
	if d.adorn then pcall(function() d.adorn:Destroy() end) end
	pcall(function()
		root.Size = d.Size
		root.CanCollide = d.CanCollide
		root.CanQuery = d.CanQuery
		root.CanTouch = d.CanTouch
	end)
	tparts[root] = nil
end

local function restoreTargets()
	for root, d in pairs(tparts) do restoreTarget(root, d) end
	tcount = 0
end

local function updateTargets()
	local ch = player.Character
	local myRoot = ch and ch:FindFirstChild("HumanoidRootPart")
	if not (enemyBoxActive() and myRoot) then
		if next(tparts) then restoreTargets() end
		tcount = 0
		return
	end
	local seen, n = {}, 0
	for hum in pairs(humanoids) do
		local model = hum.Parent
		if model and model ~= ch and not isOwnModel(model, ch) and hum:IsDescendantOf(workspace) and hum.Health > 0 and passesFilter(model) and matchesPick(model) then
			local hrp = model:FindFirstChild("HumanoidRootPart")
			local dist = hrp and hrp:IsA("BasePart") and (hrp.Position - myRoot.Position).Magnitude
			local root = dist and dist <= K.TARGET_RANGE and pickBoxPart(model)
			if root then
				local sz = enemyBoxSize(model, dist)
				seen[root] = true
				n = n + 1
				local d = tparts[root]
				if not d then
					d = { Size = root.Size, CanCollide = root.CanCollide, CanQuery = root.CanQuery, CanTouch = root.CanTouch }
					tparts[root] = d
				end
				if root.Size ~= sz then pcall(function() root.Size = sz end) end
				pcall(function()
					root.CanCollide = false
					root.CanQuery = true
					root.CanTouch = true
				end)
				if CONFIG.Visual == "Shown" then
					if not (d.adorn and d.adorn.Parent) then
						local a = Instance.new("BoxHandleAdornment")
						a.Name = "HBX_EnemyBox"
						a.Adornee = root
						a.AlwaysOnTop = false
						a.ZIndex = 1
						a.Transparency = 0.75
						a.Color3 = Color3.fromRGB(255, 80, 90)
						a.Parent = root
						d.adorn = a
					end
					d.adorn.Size = sz
				elseif d.adorn then
					pcall(function() d.adorn:Destroy() end)
					d.adorn = nil
				end
			end
		end
	end
	for root, d in pairs(tparts) do
		if not seen[root] then restoreTarget(root, d) end
	end
	tcount = n
end

