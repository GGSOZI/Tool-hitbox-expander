local function trackHits()
	local ch = player.Character
	local myRoot = ch and ch:FindFirstChild("HumanoidRootPart")
	local recent = attackRecent()
	local barsLeft = 10
	local keep = {}
	for hum in pairs(humanoids) do
		local model = hum.Parent
		if model and model ~= ch and hum:IsDescendantOf(workspace) then
			local h = hum.Health
			local last = lastHealth[hum]
			lastHealth[hum] = h
			local root = model:FindFirstChild("HumanoidRootPart")
			local dist = root and myRoot and (root.Position - myRoot.Position).Magnitude
			if last and h < last and recent and dist and dist <= CONFIG.Size + 20 then
				hitsSeen = hitsSeen + 1
				table.insert(hitLog, 1, model.Name .. "  -" .. math.floor(last - h + 0.5) .. " hp")
				if #hitLog > 6 then table.remove(hitLog) end
			end
			if CONFIG.HealthBars and gui and barsLeft > 0 and dist and dist <= 150 and h > 0 then
				barsLeft = barsLeft - 1
				keep[model] = true
				local b = healthBars[model]
				if not (b and b.gui.Parent) then
					local g = Instance.new("BillboardGui")
					g.Size = UDim2.fromOffset(60, 8)
					g.StudsOffset = Vector3.new(0, 4, 0)
					g.AlwaysOnTop = true
					g.Adornee = root
					local back = Instance.new("Frame")
					back.Size = UDim2.fromScale(1, 1)
					back.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
					back.BorderSizePixel = 0
					back.Parent = g
					local fill = Instance.new("Frame")
					fill.Size = UDim2.fromScale(1, 1)
					fill.BackgroundColor3 = Color3.fromRGB(60, 190, 90)
					fill.BorderSizePixel = 0
					fill.Parent = back
					g.Parent = gui
					b = { gui = g, fill = fill }
					healthBars[model] = b
				end
				b.fill.Size = UDim2.fromScale(math.clamp(h / math.max(hum.MaxHealth, 1), 0, 1), 1)
			end
		end
	end
	for m in pairs(healthBars) do
		if not keep[m] then removeBar(m) end
	end
end


