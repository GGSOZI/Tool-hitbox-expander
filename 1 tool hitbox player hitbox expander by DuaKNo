local function setDecals(part, hide)
	for _, c in ipairs(part:GetChildren()) do
		if c:IsA("Decal") or c:IsA("Texture") then
			if c:GetAttribute("HBX_T") == nil then c:SetAttribute("HBX_T", c.Transparency) end
			local want = hide and 1 or c:GetAttribute("HBX_T")
			if c.Transparency ~= want then pcall(function() c.Transparency = want end) end
		end
	end
end

local function makeClone(part, d)
	local ok, c = pcall(function() return part:Clone() end)
	if not ok or not c then return nil end
	for _, ch in ipairs(c:GetChildren()) do
		if not (ch:IsA("DataModelMesh") or ch:IsA("Decal") or ch:IsA("Texture") or ch:IsA("SurfaceAppearance")) then
			ch:Destroy()
		elseif ch:IsA("Decal") or ch:IsA("Texture") then
			local t = ch:GetAttribute("HBX_T")
			if t ~= nil then ch.Transparency = t end
		end
	end
	c.Name = "HBX_Visual"
	c:SetAttribute("HBX_Clone", true)
	c.Anchored = false
	c.CanCollide = false
	c.CanTouch = false
	c.CanQuery = false
	c.Massless = true
	c.Size = d.Size
	c.Transparency = d.Transparency
	c.CFrame = part.CFrame
	local w = Instance.new("WeldConstraint")
	w.Part0 = part
	w.Part1 = c
	w.Parent = c
	c.Parent = part
	return c
end

local function ensureClone(part, d)
	if CONFIG.Visual ~= "Hidden" then
		if not (d.clone and d.clone.Parent) then
			d.clone = makeClone(part, d)
		end
	elseif d.clone then
		pcall(function() d.clone:Destroy() end)
		d.clone = nil
	end
end

local function lockSize(part, d)
	if d.lock then return end
	d.lock = part:GetPropertyChangedSignal("Size"):Connect(function()
		if not alive or not CONFIG.Enabled or d.applying then return end
		local sz = targetSize(part:FindFirstAncestorOfClass("Tool"))
		if part.Size ~= sz then
			d.applying = true
			pcall(function() part.Size = sz end)
			d.applying = false
		end
	end)
end

local function expandPart(part)
	local d = parts[part]
	if not d then
		d = {
			Size = part.Size, CanCollide = part.CanCollide, Massless = part.Massless, CanTouch = part.CanTouch,
			CanQuery = part.CanQuery, CastShadow = part.CastShadow, Transparency = part.Transparency,
		}
		parts[part] = d
		setDecals(part, false)
	end
	ensureClone(part, d)
	local hide = CONFIG.Visual == "Hidden" or d.clone ~= nil
	local sz = targetSize(part:FindFirstAncestorOfClass("Tool"))
	d.applying = true
	pcall(function()
		if part.Size ~= sz then part.Size = sz end
		part.CanCollide = false
		part.CanTouch = true
		part.CanQuery = false
		part.CastShadow = false
		part.Massless = true
		if hide then
			part.Transparency = 1
		else
			part.Transparency = d.Transparency
		end
	end)
	d.applying = false
	if CONFIG.Visual == "Shown" then
		if not (d.adorn and d.adorn.Parent) then
			local a = Instance.new("BoxHandleAdornment")
			a.Name = "HBX_Box"
			a.Adornee = part
			a.AlwaysOnTop = false
			a.ZIndex = 1
			a.Transparency = 0.7
			a.Color3 = Color3.fromRGB(70, 120, 190)
			a.Parent = part
			d.adorn = a
		end
		d.adorn.Size = sz
		d.adorn.Color3 = H.pickColor(CONFIG.ToolColor)
		d.adorn.Transparency = CONFIG.BoxAlpha
	elseif d.adorn then
		pcall(function() d.adorn:Destroy() end)
		d.adorn = nil
	end
	setDecals(part, hide)
	lockSize(part, d)
end

local function restorePart(part, d)
	if d.lock then pcall(function() d.lock:Disconnect() end) end
	if d.clone then pcall(function() d.clone:Destroy() end) end
	if d.adorn then pcall(function() d.adorn:Destroy() end) end
	pcall(function() part.Size = d.Size end)
	pcall(function()
		part.CanCollide = d.CanCollide
		part.CanTouch = d.CanTouch
		part.CanQuery = d.CanQuery
		part.CastShadow = d.CastShadow
		part.Massless = d.Massless
		part.Transparency = d.Transparency
	end)
	setDecals(part, false)
	parts[part] = nil
end

local function restoreAll()
	for part, d in pairs(parts) do restorePart(part, d) end
end

local function restoreTool(tool)
	for _, p in ipairs(tool:GetDescendants()) do
		if p:IsA("BasePart") and parts[p] then restorePart(p, parts[p]) end
	end
end

local function modelRoot(model)
	local r = model:FindFirstChild("HumanoidRootPart")
	if r and r:IsA("BasePart") then return r end
	if model.PrimaryPart then return model.PrimaryPart end
	for _, nm in ipairs({ "UpperTorso", "Torso", "Head", "LowerTorso" }) do
		local p = model:FindFirstChild(nm)
		if p and p:IsA("BasePart") then return p end
	end
end

local function passesFilter(model)
	local plr = Players:GetPlayerFromCharacter(model)
	if plr then
		if CONFIG.TargetFilter == "NPCs" then return false end
		if CONFIG.IgnoreTeam and plr.Team ~= nil and plr.Team == player.Team then return false end
	elseif CONFIG.TargetFilter == "Players" then
		return false
	end
	return true
end

local function matchesPick(model)
	local n = CONFIG.TargetName
	if n == "" then return true end
	local plr = Players:GetPlayerFromCharacter(model)
	return plr ~= nil and plr.Name == n
end

K.BODY_ORDER = {
	Whole = { "HumanoidRootPart", "Head", "UpperTorso", "Torso", "LowerTorso" },
	Head = { "Head", "HumanoidRootPart", "UpperTorso", "Torso", "LowerTorso" },
	Torso = { "UpperTorso", "Torso", "HumanoidRootPart", "LowerTorso", "Head" },
	Root = { "HumanoidRootPart", "UpperTorso", "Torso", "LowerTorso", "Head" },
}

local function targetsAround(center, radius, maxN, nParts)
	nParts = nParts or 3
	if H.methodOn("FullBody") and CONFIG.BodyPart == "Whole" then nParts = math.max(nParts, 16) end
	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local cam = workspace.CurrentCamera
	local order = K.BODY_ORDER[CONFIG.BodyPart] or K.BODY_ORDER.Whole
	if lockedModel then
		local lh = lockedModel.Parent and lockedModel:FindFirstChildOfClass("Humanoid")
		if not (lh and lh.Health > 0) then lockedModel = nil end
	end
	local cands = {}
	for hum in pairs(humanoids) do
		local model = hum.Parent
		if not model or not hum:IsDescendantOf(workspace) then
			humanoids[hum] = nil
		elseif model ~= myChar and hum.Health > 0 and (not lockedModel or model == lockedModel) and passesFilter(model) then
			local root = modelRoot(model)
			if root then
				local dist = (root.Position - center).Magnitude
				local ok = dist <= radius + 3
				if ok and not lockedModel then
					if CONFIG.FrontOnly and myRoot then
						local rel = root.Position - myRoot.Position
						if rel.Magnitude > 4 and myRoot.CFrame.LookVector:Dot(rel.Unit) < 0.1 then ok = false end
					end
					if ok and CONFIG.AimAssist and cam then
						local v = root.Position - cam.CFrame.Position
						if v.Magnitude > 1 and cam.CFrame.LookVector:Dot(v.Unit) < 0.92 then ok = false end
					end
				end
				if ok then
					local list = {}
					for _, nm in ipairs(order) do
						local tp = model:FindFirstChild(nm)
						if tp and tp:IsA("BasePart") then
							list[#list + 1] = tp
							if #list >= nParts then break end
						end
					end
					if #list < nParts then
						for _, c in ipairs(model:GetChildren()) do
							if c:IsA("BasePart") and not c:GetAttribute("HBX_Clone") and not table.find(list, c) then
								list[#list + 1] = c
								if #list >= nParts then break end
							end
						end
					end
					if #list > 0 then cands[#cands + 1] = { model = model, list = list, dist = dist } end
				end
			end
		end
	end
	table.sort(cands, function(a, b) return a.dist < b.dist end)
	while #cands > (maxN or 6) do table.remove(cands) end
	return cands
end

local overlapParams = OverlapParams.new()
K.OVERLAP_RANGE = 120

-- Force: every enemy part that really overlaps the reach sphere (limbs, head, anything), not just the first few
local function overlapExtra(targets, center, radius)
	if not H.methodOn("Overlap") then return targets end
	local ch = player.Character
	overlapParams.FilterType = Enum.RaycastFilterType.Exclude
	overlapParams.FilterDescendantsInstances = ch and { ch } or {}
	overlapParams.MaxParts = 150
	local ok, found = pcall(workspace.GetPartBoundsInRadius, workspace, center, math.min(radius + 3, K.OVERLAP_RANGE), overlapParams)
	if not ok or type(found) ~= "table" then return targets end
	local have = {}
	for _, t in ipairs(targets) do have[t] = true end
	local added = 0
	for _, p in ipairs(found) do
		if not have[p] and not p:GetAttribute("HBX_Clone") then
			local model = p:FindFirstAncestorOfClass("Model")
			local hum = model and model:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 and model ~= ch and (not lockedModel or model == lockedModel) and passesFilter(model) then
				have[p] = true
				targets[#targets + 1] = p
				added = added + 1
				if added >= 24 then break end
			end
		end
	end
	return targets
end

local function fireAll(fromParts, targets)
	if CONFIG.HoldMode and not UserInputService:IsKeyDown(CONFIG.HoldKey) then return end
	touchBursts = touchBursts + 1
	if CONFIG.ForcePower >= 2 then
		for _, tp in ipairs(targets) do pcall(function() tp.CanTouch = true end) end
	end
	for _, tp in ipairs(targets) do
		for _, p in ipairs(fromParts) do pcall(firetouchinterest, p, tp, 0) end
	end
	task.wait()
	for _, tp in ipairs(targets) do
		for _, p in ipairs(fromParts) do pcall(firetouchinterest, p, tp, 1) end
	end
	-- Force: also fire the Touched signal itself (local scripts listening on your parts)
	if H.methodOn("SignalFire") and hasSignal then
		for i = 1, math.min(#fromParts, 3) do
			for j = 1, math.min(#targets, 24) do
				pcall(firesignal, fromParts[i].Touched, targets[j])
			end
		end
	end
end

local function flatten(cands)
	local targets = {}
	for _, c in ipairs(cands) do
		for _, tp in ipairs(c.list) do targets[#targets + 1] = tp end
	end
	return targets
end

local toolPartCache = setmetatable({}, { __mode = "k" })

local function forceTouchOnce(tool)
	local now = os.clock()
	local cache = toolPartCache[tool]
	if not cache or now - cache.t > 1 then
		local list = {}
		for _, d in ipairs(tool:GetDescendants()) do
			if d:IsA("BasePart") and not d:GetAttribute("HBX_Clone") then list[#list + 1] = d end
		end
		table.sort(list, function(a, b) return (a.Name == "Handle" and 1 or 0) > (b.Name == "Handle" and 1 or 0) end)
		cache = { t = now, list = list }
		toolPartCache[tool] = cache
	end
	local P = power()
	local toolParts = {}
	for i = 1, math.min(#cache.list, P.toolParts) do toolParts[i] = cache.list[i] end
	if #toolParts == 0 then return end
	local ch = tool.Parent
	if ch and ch:IsA("Model") then
		for _, nm in ipairs({ "RightHand", "Right Arm" }) do
			local h = ch:FindFirstChild(nm)
			if h and h:IsA("BasePart") then
				toolParts[#toolParts + 1] = h
				break
			end
		end
	end
	local targets = flatten(targetsAround(toolParts[1].Position, toolSizeFor(tool), P.enemies, P.targetParts))
	targets = overlapExtra(targets, toolParts[1].Position, toolSizeFor(tool))
	targets = H.objectExtra(targets, toolParts[1].Position, toolSizeFor(tool))
	if #targets == 0 then return end
	-- Force: briefly put the handle on the enemy so a real touch happens, then put it back
	local snapH, snapCF
	if H.methodOn("SnapTool") then
		local h = tool:FindFirstChild("Handle")
		if h and h:IsA("BasePart") and targets[1].Parent then
			snapH, snapCF = h, h.CFrame
			pcall(function() h.CFrame = targets[1].CFrame end)
		end
	end
	fireAll(toolParts, targets)
	if snapH and snapH.Parent then pcall(function() snapH.CFrame = snapCF end) end
end

local function forceBurst(tool)
	if not (CONFIG.Enabled and CONFIG.ForceTouch and hasFTI) then return end

	toolUntil[tool] = os.clock() + math.max(0.4, CONFIG.BurstTime)
	if bursting[tool] then return end
	bursting[tool] = true
	task.spawn(function()
		local sm = H.smartBegin()
		local retries, h0, b0 = 0, hitsSeen, touchBursts
		while alive and CONFIG.Enabled and CONFIG.ForceTouch and tool.Parent do
			local now = os.clock()
			if now >= (toolUntil[tool] or 0) and not (heldCount > 0 and now - lastActivate < 8) then
				local again = false
				if CONFIG.AutoRetry and retries < 2 and touchBursts > b0 then
					task.wait(0.3)
					if hitsSeen == h0 then again = true end
				end
				if not again then break end
				retries = retries + 1
				lastActivate = os.clock()
				toolUntil[tool] = os.clock() + math.max(0.4, CONFIG.BurstTime)
			end
			pcall(forceTouchOnce, tool)
			task.wait(H.touchGap())
		end
		if sm then H.smartEnd() end
		bursting[tool] = nil
	end)
end

local STANDARD = {}
for _, n in ipairs({
	"Head", "Torso", "HumanoidRootPart", "Left Arm", "Right Arm", "Left Leg", "Right Leg", "UpperTorso", "LowerTorso",
	"LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand",
	"LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot",
}) do STANDARD[n] = true end

local function charPartsRaw(ch, cap)
	cap = cap or 5
	local list = {}

	local custom = 0
	for _, c in ipairs(ch:GetChildren()) do
		local p
		if c:IsA("BasePart") and not STANDARD[c.Name] and not c:GetAttribute("HBX_Clone") then
			p = c
		elseif c:IsA("Model") then
			p = c:FindFirstChildWhichIsA("BasePart", true)
		end
		if p then
			list[#list + 1] = p
			custom = custom + 1
			if custom >= 2 then break end
		end
	end

	local tool = ch:FindFirstChildOfClass("Tool")
	if tool then
		local h = tool:FindFirstChild("Handle")
		if h and h:IsA("BasePart") then list[#list + 1] = h end
	end
	for _, nm in ipairs({ "RightHand", "Right Arm", "LeftHand", "Left Arm", "HumanoidRootPart", "RightFoot", "Right Leg", "LeftFoot", "Left Leg" }) do
		local p = ch:FindFirstChild(nm)
		if p and p:IsA("BasePart") then
			list[#list + 1] = p
			if #list >= cap then break end
		end
	end
	return list
end

local charCache = {}

local function charParts(ch, cap)
	cap = cap or 5
	local c = charCache[cap]
	if c and c.ch == ch and #c.list > 0 and os.clock() - c.t < 1 then return c.list end
	local list = charPartsRaw(ch, cap)
	charCache[cap] = { ch = ch, t = os.clock(), list = list }
	return list
end

local registerProjectile

local function actionBurst(manual)
	if not (CONFIG.Enabled and (CONFIG.Moves or manual) and CONFIG.ForceTouch and hasFTI) then return end

	actionUntil = math.max(actionUntil, os.clock() + CONFIG.BurstTime)

	pcall(function()
		local ch = player.Character
		if not ch then return end
		local n = 0
		for _, d in ipairs(ch:GetDescendants()) do
			if d:IsA("BasePart") and not STANDARD[d.Name] and not d:GetAttribute("HBX_Clone")
				and not d:FindFirstAncestorOfClass("Accessory") and not d:FindFirstAncestorOfClass("Tool") then
				registerProjectile(d, CONFIG.BurstTime + 1, true)
				n = n + 1
				if n >= 10 then break end
			end
		end
	end)
	if actionBusy then return end
	actionBusy = true
	task.spawn(function()
		local sm = H.smartBegin()
		local retries, h0, b0 = 0, hitsSeen, touchBursts
		while alive and CONFIG.Enabled and (CONFIG.Moves or manual) and CONFIG.ForceTouch do
			local now = os.clock()
			if now >= actionUntil and not (heldCount > 0 and now - lastActivate < 8) then
				local again = false
				if CONFIG.AutoRetry and retries < 2 and touchBursts > b0 then
					task.wait(0.3)
					if hitsSeen == h0 then again = true end
				end
				if not again then break end
				retries = retries + 1
				lastActivate = os.clock()
				actionUntil = os.clock() + CONFIG.BurstTime
			end
			pcall(function()
				local ch = player.Character
				local root = ch and ch:FindFirstChild("HumanoidRootPart")
				if not root then return end
				local P = power()
				local mine = charParts(ch, P.toolParts + 2)
				if #mine == 0 then return end
				local targets = flatten(targetsAround(root.Position, CONFIG.Size, math.min(P.enemies, 6), P.targetParts))
				targets = overlapExtra(targets, root.Position, CONFIG.Size)
				targets = H.objectExtra(targets, root.Position, CONFIG.Size)
				if #targets == 0 then return end
				fireAll(mine, targets)
			end)
			task.wait(H.touchGap())
		end
		if sm then H.smartEnd() end
		actionBusy = false
	end)
end

local function forceNow()
	if not CONFIG.Enabled then return end
	lastActivate = os.clock()
	actionBurst(true)
	local ch = player.Character
	local tool = ch and ch:FindFirstChildOfClass("Tool")
	if tool then forceBurst(tool) end
end

registerProjectile = function(part, life, noResize)
	if part:GetAttribute("HBX_Clone") then return end
	local rec = projectiles[part]
	if rec then
		rec.exp = math.max(rec.exp, os.clock() + (life or K.PROJECTILE_LIFE))
		return
	end
	local n, oldest, oldestT = 0, nil, math.huge
	for p2, r2 in pairs(projectiles) do
		n = n + 1
		if r2.exp < oldestT then oldest, oldestT = p2, r2.exp end
	end
	if n >= K.PROJECTILE_MAX then
		if oldest then projectiles[oldest] = nil else return end
	end
	rec = { exp = os.clock() + (life or K.PROJECTILE_LIFE), hit = {} }
	projectiles[part] = rec
	if noResize or CONFIG.Safe then return end

	if (not part.CanCollide) or not (hasFTI and CONFIG.ForceTouch) then
		local m = math.min(CONFIG.Size, part.CanCollide and 30 or 60)
		pcall(function()
			local s = part.Size
			rec.orig = s
			rec.sizeUntil = os.clock() + 3
			part.Size = Vector3.new(math.max(s.X, m), math.max(s.Y, m), math.max(s.Z, m))
			part.CanTouch = true
		end)
	end
end

local function projectileStep(part, rec)
	local now = os.clock()
	local touch = {}
	for _, c in ipairs(targetsAround(part.Position, CONFIG.Size, 4, power().targetParts)) do
		if (rec.hit[c.model] or 0) < now then
			rec.hit[c.model] = now + 0.3
			for _, tp in ipairs(c.list) do touch[#touch + 1] = tp end
		end
	end
	touch = overlapExtra(touch, part.Position, CONFIG.Size)
	touch = H.objectExtra(touch, part.Position, CONFIG.Size)
	if #touch == 0 then return end
	task.spawn(function() fireAll({ part }, touch) end)
end

local function projectileLoop()
	local now = os.clock()
	for part, rec in pairs(projectiles) do
		if rec.orig and part.Parent and now > (rec.sizeUntil or 0) then
			pcall(function() part.Size = rec.orig end)
			rec.orig = nil
		end
		if not part.Parent or now > rec.exp then
			if rec.orig and part.Parent then pcall(function() part.Size = rec.orig end) end
			projectiles[part] = nil
		elseif hasFTI and CONFIG.ForceTouch then
			pcall(projectileStep, part, rec)
		end
	end
end

