	pcall(H.updateRadar)
end))

-- NAMECALL HOOK (used by remote spy and ray assist). Installed once per session, later runs just swap the handler.
local env = (getgenv and getgenv()) or _G
local canNamecall = type(getnamecallmethod) == "function"
	and (type(hookmetamethod) == "function" or (type(getrawmetatable) == "function" and type(setreadonly) == "function"))
local hasHook = canNamecall or type(hookfunction) == "function"
local HOOK_M = {
	FireServer = true, InvokeServer = true, fireServer = true, invokeServer = true, Raycast = true,
	FindPartOnRay = true, FindPartOnRayWithIgnoreList = true, FindPartOnRayWithWhitelist = true,
}
local spy = {
	on = false, log = {}, view = "log", attackOnly = false, dirty = false, skipped = 0, total = 0, nameCount = 0,
	names = {}, rate = {}, autoCount = 0, filter = "",
}
local function ensureHook()
	if not hasHook then
		spy.hookInfo = "this executor has no hookmetamethod/getrawmetatable or hookfunction"
		return false
	end
	if env.HBX_hookOK then
		spy.hookInfo = spy.hookInfo or "active (installed earlier this session)"
		return true
	end
	local wrap = type(newcclosure) == "function" and newcclosure or function(f) return f end
	local setm = type(setnamecallmethod) == "function" and setnamecallmethod or nil
	local ok = false
	if canNamecall then
		ok = pcall(function()
			local old
			local hook = wrap(function(self, ...)
				local method = getnamecallmethod()
				if HOOK_M[method] and env.HBX_NC and not env.HBX_busy then
					env.HBX_busy = true
					local okc, r = pcall(env.HBX_NC, self, method, table.pack(...))
					env.HBX_busy = false
					if setm then setm(method) end
					local pend = env.HBX_pending
					env.HBX_pending = nil
					if okc and r then
						if r == "BLOCK" then return nil end
						if pend then
							local ret = table.pack(old(self, table.unpack(r, 1, r.n)))
							pend.ret = ret
							spy.dirty = true
							return table.unpack(ret, 1, ret.n)
						end
						return old(self, table.unpack(r, 1, r.n))
					end
					if pend then
						local ret = table.pack(old(self, ...))
						pend.ret = ret
						spy.dirty = true
						return table.unpack(ret, 1, ret.n)
					end
				end
				return old(self, ...)
			end)
			if type(hookmetamethod) == "function" then
				old = hookmetamethod(game, "__namecall", hook)
			else
				local gm = getrawmetatable(game)
				old = gm.__namecall
				setreadonly(gm, false)
				gm.__namecall = hook
				setreadonly(gm, true)
			end
		end)
	end
	-- the functions themselves too, for scripts that call them without the namecall syntax (SimpleSpy does both)
	local fnOk = false
	if type(hookfunction) == "function" then
		fnOk = pcall(function()
			local function hookFn(inst, name)
				local old
				old = hookfunction(inst[name], wrap(function(self, ...)
					if env.HBX_NC and not env.HBX_busy then
						env.HBX_busy = true
						local okc, r = pcall(env.HBX_NC, self, name, table.pack(...))
						env.HBX_busy = false
						local pend = env.HBX_pending
						env.HBX_pending = nil
						if okc and r == "BLOCK" then return nil end
						if okc and type(r) == "table" then
							if pend then
								local ret = table.pack(old(self, table.unpack(r, 1, r.n)))
								pend.ret = ret
								spy.dirty = true
								return table.unpack(ret, 1, ret.n)
							end
							return old(self, table.unpack(r, 1, r.n))
						end
						if pend then
							local ret = table.pack(old(self, ...))
							pend.ret = ret
							spy.dirty = true
							return table.unpack(ret, 1, ret.n)
						end
					end
					return old(self, ...)
				end))
			end
			hookFn(Instance.new("RemoteEvent"), "FireServer")
			hookFn(Instance.new("RemoteFunction"), "InvokeServer")
			pcall(hookFn, Instance.new("UnreliableRemoteEvent"), "FireServer")
		end)
	end
	spy.hookInfo = "namecall " .. (ok and "ok" or (canNamecall and "failed" or "unsupported")) .. ", function hooks " .. (fnOk and "ok" or "failed or unsupported")
	if ok or fnOk then env.HBX_hookOK = true end
	return ok or fnOk
end

-- RAY ASSIST: bends raycasts toward enemy parts that pass close to the ray (client side only)
local rayCache = { t = -1, list = {} }
function H.refreshRayTargets()
	local list = {}
	local ch = player.Character
	for hum in pairs(humanoids) do
		local model = hum.Parent
		if model and model ~= ch and hum.Health > 0 and hum:IsDescendantOf(workspace) and not isOwnModel(model, ch) and passesFilter(model) and matchesPick(model) then
			local part
			if CONFIG.BodyPart == "Head" then
				part = model:FindFirstChild("Head")
			elseif CONFIG.BodyPart == "Torso" then
				part = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
			elseif CONFIG.BodyPart == "Root" then
				part = model:FindFirstChild("HumanoidRootPart")
			end
			part = (part and part:IsA("BasePart") and part) or modelRoot(model)
			if part then list[#list + 1] = part end
		end
	end
	rayCache.list = list
end
function H.rayTargets() return rayCache.list end
function H.assistVector(origin, dir)
	if typeof(origin) ~= "Vector3" or typeof(dir) ~= "Vector3" then return nil end
	local len = dir.Magnitude
	if len < 1 then return nil end
	local unit = dir / len
	local radius = CONFIG.RayRadius
	local best, bestT
	for _, part in ipairs(H.rayTargets()) do
		local rel = part.Position - origin
		local t = rel:Dot(unit)
		if t > 0 and t < len + radius then
			local d = (rel - unit * t).Magnitude
			if d <= radius and (not bestT or t < bestT) then best, bestT = part, t end
		end
	end
	if not best then return nil end
	local to = best.Position - origin
	return to.Unit * math.max(len, to.Magnitude + 2)
end

-- REMOTE SPY
function H.spyLog(remote, method, args)
	spy.lastRec = nil
	if not spy.on or spy.replaying then return nil end
	local ok, cls = pcall(function() return remote.ClassName end)
	if not ok or not (cls == "RemoteEvent" or cls == "RemoteFunction" or cls == "UnreliableRemoteEvent") then return nil end
	local name = remote.Name
	local nowT = os.clock()
	local blocked = CONFIG.SpyBlocked[name] and "BLOCK" or nil
	-- spam detection: a remote firing more than 20 times a second gets excluded when Auto is on
	local r = spy.rate[name]
	if not r or nowT - r.t > 1 then
		r = { t = nowT, n = 0 }
		spy.rate[name] = r
	end
	r.n = r.n + 1
	if CONFIG.SpyAuto and r.n > 20 and not CONFIG.SpyExcluded[name] and not blocked then
		CONFIG.SpyExcluded[name] = true
		spy.autoCount = spy.autoCount + 1
		spy.notice, spy.noticeUntil = "Auto-excluded " .. name .. " (spam)", nowT + 6
		spy.saveNeeded = true
	end
	if CONFIG.SpyExcluded[name] then
		spy.skipped = spy.skipped + 1
		return blocked
	end
	if CONFIG.SpyWhiteOn and not CONFIG.SpyWhite[name] then return blocked end
	if spy.attackOnly and nowT - lastActivate > 1.5 then return blocked end
	local last = spy.last
	if last and last.remote == remote and last.method == method and nowT - last.t < 0.003 and last.n == args.n then return blocked end
	spy.last = { remote = remote, method = method, t = nowT, n = args.n }
	local rec = { remote = remote, name = name, method = method, args = args, t = nowT, blocked = blocked ~= nil, dir = "out" }
	if CONFIG.SpyScripts and type(getcallingscript) == "function" then
		local okS, scr = pcall(getcallingscript)
		if okS and typeof(scr) == "Instance" then rec.script = scr end
	end
	spy.log[#spy.log + 1] = rec
	if #spy.log > 500 then table.remove(spy.log, 1) end
	spy.total = spy.total + 1
	if not spy.names[name] then
		spy.names[name] = true
		spy.nameCount = spy.nameCount + 1
	end
	spy.lastRec = rec
	if spy.recording then
		local rc = spy.recording
		if #rc.recs < 200 then rc.recs[#rc.recs + 1] = { rec = rec, delay = nowT - rc.last } end
		rc.last = nowT
	end
	if method == "InvokeServer" and not blocked then env.HBX_pending = rec end
	spy.dirty = true
	return blocked
end

-- server -> client calls (OnClientEvent)
function H.incomingLog(remote, args)
	if not spy.on or spy.replaying then return end
	local name = remote.Name
	local nowT = os.clock()
	if CONFIG.SpyExcluded[name] then
		spy.skipped = spy.skipped + 1
		return
	end
	if CONFIG.SpyWhiteOn and not CONFIG.SpyWhite[name] then return end
	local last = spy.lastIn
	if last and last.remote == remote and nowT - last.t < 0.003 and last.n == args.n then return end
	spy.lastIn = { remote = remote, t = nowT, n = args.n }
	spy.log[#spy.log + 1] = { remote = remote, name = name, method = "OnClientEvent", args = args, t = nowT, dir = "in" }
	if #spy.log > 500 then table.remove(spy.log, 1) end
	spy.total = spy.total + 1
	if not spy.names[name] then
		spy.names[name] = true
		spy.nameCount = spy.nameCount + 1
	end
	spy.dirty = true
end
function H.isRemoteEvt(d)
	local ok, cls = pcall(function() return d.ClassName end)
	return ok and (cls == "RemoteEvent" or cls == "UnreliableRemoteEvent")
end
spy.inConns = {}
spy.inHooked = setmetatable({}, { __mode = "k" })
function H.hookIncoming(remote)
	if spy.inHooked[remote] then return end
	spy.inHooked[remote] = true
	local ok, conn = pcall(function()
		return remote.OnClientEvent:Connect(function(...)
			H.incomingLog(remote, table.pack(...))
		end)
	end)
	if ok and conn then table.insert(spy.inConns, conn) end
end
function H.setIncoming(on)
	for _, c in ipairs(spy.inConns) do pcall(function() c:Disconnect() end) end
	spy.inConns = {}
	spy.inHooked = setmetatable({}, { __mode = "k" })
	if spy.inAdded then
		pcall(function() spy.inAdded:Disconnect() end)
		spy.inAdded = nil
	end
	spy.inActive = on
	if not on then return end
	pcall(function()
		for _, d in ipairs(game:GetDescendants()) do
			if H.isRemoteEvt(d) then H.hookIncoming(d) end
		end
	end)
	spy.inAdded = game.DescendantAdded:Connect(function(d)
		if H.isRemoteEvt(d) then H.hookIncoming(d) end
	end)
end

-- argument rewrite rules (applied while the spy is recording)
local ruleFns = setmetatable({}, { __mode = "k" })
function H.ruleFn(rule)
	local c = ruleFns[rule]
	if c ~= nil then return c or nil end
	local ls = loadstring or load
	local f
	if ls then f = ls("local target, myroot, args, remote = ...\nreturn " .. rule.expr) end
	ruleFns[rule] = f or false
	return f
end
function H.nearestTargetPart()
	local now = os.clock()
	if now - rayCache.t > 0.15 then
		rayCache.t = now
		pcall(H.refreshRayTargets)
	end
	local ch = player.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	if not root then return nil, nil end
	local best, bd
	for _, p in ipairs(rayCache.list) do
		if p.Parent then
			local d = (p.Position - root.Position).Magnitude
			if not bd or d < bd then best, bd = p, d end
		end
	end
	return best, root
end
function H.applyRules(remote, method, args)
	local rules = CONFIG.SpyRules
	if not spy.on or spy.replaying or #rules == 0 then return nil end
	local okn, name = pcall(function() return remote.Name end)
	if not okn then return nil end
	local na, tp, root
	local changed = false
	for _, rule in ipairs(rules) do
		if rule.on and rule.name == name then
			if not na then
				na = table.pack(table.unpack(args, 1, args.n))
				tp, root = H.nearestTargetPart()
			end
			if rule.idx == 0 then
				if tp then
					for i = 1, na.n do
						local v = na[i]
						local t = typeof(v)
						if t == "Vector3" then
							na[i] = tp.Position
							changed = true
						elseif t == "CFrame" then
							na[i] = tp.CFrame
							changed = true
						elseif t == "Instance" then
							if v:IsA("BasePart") then
								na[i] = tp
								changed = true
							elseif v:IsA("Humanoid") then
								na[i] = (tp.Parent and tp.Parent:FindFirstChildOfClass("Humanoid")) or v
								changed = true
							elseif v:IsA("Model") and tp.Parent then
								na[i] = tp.Parent
								changed = true
							end
						end
					end
				end
			else
				local f = H.ruleFn(rule)
				if f then
					local ok, v = pcall(f, tp, root, na, remote)
					if ok then
						na[rule.idx] = v
						if rule.idx > na.n then na.n = rule.idx end
						changed = true
					end
				end
			end
		end
	end
	if changed then
		if spy.lastRec then spy.lastRec.rewritten = true end
		return na
	end
	return nil
end
env.HBX_NC = function(self, method, args)
	if not alive then return nil end
	local lm = method:lower()
	if lm == "fireserver" or lm == "invokeserver" then
		local nm = lm == "fireserver" and "FireServer" or "InvokeServer"
		local blocked = H.spyLog(self, nm, args)
		if blocked then return blocked end
		return H.applyRules(self, nm, args)
	end
	if not (CONFIG.RayAssist and CONFIG.Enabled) or self ~= workspace then return nil end
	if method == "Raycast" then
		local nd = H.assistVector(args[1], args[2])
		if nd then
			local na = table.pack(table.unpack(args, 1, args.n))
			na[2] = nd
			return na
		end
	else
		local r = args[1]
		if typeof(r) == "Ray" then
			local nd = H.assistVector(r.Origin, r.Direction)
			if nd then
				local na = table.pack(table.unpack(args, 1, args.n))
				na[1] = Ray.new(r.Origin, nd)
				return na
			end
		end
	end
	return nil
end
