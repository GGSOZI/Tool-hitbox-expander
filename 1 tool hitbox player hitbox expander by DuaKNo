	f.Size = UDim2.fromOffset(sz, sz)
	f.Position = radar.pos or UDim2.new(1, -(sz + 12), 0, 96)
	f.BackgroundColor3 = Color3.fromRGB(12, 10, 18)
	f.BackgroundTransparency = 0.25
	f.BorderSizePixel = 0
	f.Active = true
	f.Parent = espGui
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.5, 0)
	c.Parent = f
	local st = Instance.new("UIStroke")
	st.Thickness = 2
	st.Color = edgeColor(0)
	st.Parent = f
	radar.stroke = st
	local ring = Instance.new("Frame")
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	ring.Position = UDim2.fromScale(0.5, 0.5)
	ring.Size = UDim2.fromScale(0.5, 0.5)
	ring.BackgroundTransparency = 1
	ring.Parent = f
	local rc = Instance.new("UICorner")
	rc.CornerRadius = UDim.new(0.5, 0)
	rc.Parent = ring
	local rs = Instance.new("UIStroke")
	rs.Thickness = 1
	rs.Transparency = 0.7
	rs.Color = Color3.new(1, 1, 1)
	rs.Parent = ring
	for _, vert in ipairs({ false, true }) do
		local l = Instance.new("Frame")
		l.BorderSizePixel = 0
		l.BackgroundColor3 = Color3.new(1, 1, 1)
		l.BackgroundTransparency = 0.85
		if vert then
			l.Size = UDim2.new(0, 1, 1, 0)
			l.Position = UDim2.fromScale(0.5, 0)
		else
			l.Size = UDim2.new(1, 0, 0, 1)
			l.Position = UDim2.fromScale(0, 0.5)
		end
		l.Parent = f
	end
	local me = Instance.new("Frame")
	me.AnchorPoint = Vector2.new(0.5, 0.5)
	me.Position = UDim2.fromScale(0.5, 0.5)
	me.Size = UDim2.fromOffset(7, 7)
	me.BorderSizePixel = 0
	me.BackgroundColor3 = Color3.new(1, 1, 1)
	local mc = Instance.new("UICorner")
	mc.CornerRadius = UDim.new(0.5, 0)
	mc.Parent = me
	me.Parent = f
	radar.frame = f
	makeDraggable(f, f, nil)
	return true
end
function H.updateRadar()
	if not (CONFIG.Radar and alive) then
		if radar.frame then H.destroyRadar() end
		return
	end
	if not (radar.frame and radar.frame.Parent) then
		if not H.buildRadar() then return end
	end
	local f = radar.frame
	radar.pos = f.Position
	local sz = CONFIG.RadarSize
	if f.Size.X.Offset ~= sz then f.Size = UDim2.fromOffset(sz, sz) end
	radar.stroke.Color = edgeColor(os.clock())
	local cam = workspace.CurrentCamera
	local ch = player.Character
	local myRoot = ch and ch:FindFirstChild("HumanoidRootPart")
	if not (cam and myRoot) then return end
	local range = CONFIG.RadarRange
	local half = sz / 2 - 5
	local cf = cam.CFrame
	local look = cf.LookVector
	local fl = Vector3.new(look.X, 0, look.Z)
	if fl.Magnitude < 0.05 then fl = Vector3.new(cf.UpVector.X, 0, cf.UpVector.Z) end
	if fl.Magnitude < 0.01 then return end
	fl = fl.Unit
	local rt = Vector3.new(-fl.Z, 0, fl.X)
	local origin = myRoot.Position
	local used = 0
	local function place(worldPos, col, size, square)
		used = used + 1
		local d = radar.dots[used]
		if not (d and d.Parent) then
			d = Instance.new("Frame")
			d.AnchorPoint = Vector2.new(0.5, 0.5)
			d.BorderSizePixel = 0
			local cr = Instance.new("UICorner")
			cr.Parent = d
			d.Parent = f
			radar.dots[used] = d
			radar.corners[used] = cr
		end
		local rel = worldPos - origin
		local x, y = rel:Dot(rt), -rel:Dot(fl)
		local m = math.sqrt(x * x + y * y)
		local edge = m > range
		if edge then x, y = x / m * range, y / m * range end
		d.Position = UDim2.new(0.5, x / range * half, 0.5, y / range * half)
		d.Size = UDim2.fromOffset(size, size)
		d.BackgroundColor3 = col
		d.BackgroundTransparency = edge and 0.6 or 0
		radar.corners[used].CornerRadius = UDim.new(square and 0 or 0.5, 0)
		d.Visible = true
	end
	for hum in pairs(humanoids) do
		local model = hum.Parent
		if model and model ~= ch and hum.Health > 0 and hum:IsDescendantOf(workspace) and not isOwnModel(model, ch) and passesFilter(model) then
			local root = modelRoot(model)
			if root and used < 60 then
				local picked = CONFIG.TargetName ~= "" and matchesPick(model)
				place(root.Position, picked and Color3.new(1, 1, 1) or H.espColor(model, hum), picked and 9 or 6, false)
			end
		end
	end
	if CONFIG.RadarObjects then
		for i, p in ipairs(objects.list) do
			if i > 30 or not p.Parent then break end
			place(p.Position, K.COLORS.Orange, 4, true)
		end
	end
	for i = used + 1, #radar.dots do
		if radar.dots[i] then radar.dots[i].Visible = false end
	end
end
