		bar1.Position, bar1.Size = UDim2.fromOffset(8, y), UDim2.new(1, -16, 0, 26)
		y = y + 28
		bar2.Position, bar2.Size = UDim2.fromOffset(8, y), UDim2.new(1, -16, 0, 26)
		y = y + 28
		bar3.Visible = spy.more
		if spy.more then
			bar3.Position, bar3.Size = UDim2.fromOffset(8, y), UDim2.new(1, -16, 0, 26)
			y = y + 28
		end
		filterBox.Position, filterBox.Size = UDim2.fromOffset(8, y), UDim2.new(1, -16, 0, 24)
		y = y + 28
		local below = 4 + 22 + 4 + 56 + (spy.more and 56 or 0) + 30 + 8
		local R = math.max(spy.h - y - below, 110)
		local hL = math.floor(R * 0.42)
		local hB = R - hL
		for _, sc in ipairs({ spy.logScroll, spy.viewScroll }) do
			sc.Position, sc.Size = UDim2.fromOffset(8, y), UDim2.new(1, -16, 0, hL)
		end
		y = y + hL + 4
		spy.info.Position, spy.info.Size = UDim2.fromOffset(8, y), UDim2.new(1, -80, 0, 18)
		prevB.Position = UDim2.new(1, -68, 0, y)
		nextB.Position = UDim2.new(1, -36, 0, y)
		y = y + 22
		spy.box.Position, spy.box.Size = UDim2.fromOffset(8, y), UDim2.new(1, -16, 0, hB)
		y = y + hB + 4
		act1.Position, act1.Size = UDim2.fromOffset(8, y), UDim2.new(1, -16, 0, 26)
		y = y + 28
		act2.Position, act2.Size = UDim2.fromOffset(8, y), UDim2.new(1, -16, 0, 26)
		y = y + 28
		act3.Visible, act4.Visible = spy.more, spy.more
		if spy.more then
			act3.Position, act3.Size = UDim2.fromOffset(8, y), UDim2.new(1, -16, 0, 26)
			y = y + 28
			act4.Position, act4.Size = UDim2.fromOffset(8, y), UDim2.new(1, -16, 0, 26)
			y = y + 28
		end
		spy.status.Position, spy.status.Size = UDim2.fromOffset(8, y + 2), UDim2.new(1, -40, 0, 30)
	end
	layout()

	local function say(msg)
		spy.status.Text = msg
		spy.statusUntil = os.clock() + 4
	end
	local function count(t)
		local n = 0
		for _ in pairs(t) do n = n + 1 end
		return n
	end
	local function blockedSel() return spy.sel and spy.sel.dir ~= "in" and CONFIG.SpyBlocked[spy.sel.name] end
	local function refreshBar()
		local v = spy.view
		pauseB.Text = spy.on and "Pause" or "Resume"
		pauseB.BackgroundColor3 = spy.on and C.cardHi or C.accent
		atkB.BackgroundColor3 = spy.attackOnly and C.accent or C.cardHi
		viewB.Text = "View: " .. CONFIG.SpyView
		excB.Text = "Excluded (" .. count(CONFIG.SpyExcluded) .. ")"
		excB.BackgroundColor3 = v == "exc" and C.accent or C.cardHi
		blkB.Text = "Blocked (" .. count(CONFIG.SpyBlocked) .. ")"
		blkB.BackgroundColor3 = v == "blk" and C.accent or C.cardHi
		autoB.Text = "Auto: " .. (CONFIG.SpyAuto and "ON" or "OFF")
		autoB.BackgroundColor3 = CONFIG.SpyAuto and C.accent or C.cardHi
		moreB.Text = spy.more and "Less" or "More"
		whtB.Text = "White (" .. count(CONFIG.SpyWhite) .. ")" .. (CONFIG.SpyWhiteOn and " ON" or "")
		whtB.BackgroundColor3 = (v == "wht" or CONFIG.SpyWhiteOn) and C.accent or C.cardHi
		macB.Text = "Macros (" .. #CONFIG.SpyMacros .. ")"
		macB.BackgroundColor3 = (v == "mac" or spy.recording) and C.accent or C.cardHi
		rwB.Text = "Rewrite (" .. #CONFIG.SpyRules .. ")"
		rwB.BackgroundColor3 = v == "rw" and C.accent or C.cardHi
		inB.Text = "Incoming: " .. (CONFIG.SpyIncoming and "ON" or "OFF")
		inB.BackgroundColor3 = CONFIG.SpyIncoming and C.accent or C.cardHi
		scrB.Text = "Script: " .. (CONFIG.SpyScripts and "ON" or "OFF")
		scrB.BackgroundColor3 = CONFIG.SpyScripts and C.accent or C.cardHi
		argsB.BackgroundColor3 = v == "args" and C.accent or C.cardHi
		repB.Text = "Repeat x" .. CONFIG.SpyRepeat
		blockB.Text = blockedSel() and "Unblock" or "Block"
		blockB.BackgroundColor3 = blockedSel() and C.accent or C.cardHi
	end

	local rebuildLog, rebuildNames, rebuildMacros, rebuildRules, rebuildArgs, setView
	local function showRec(rec)
		spy.sel = rec
		rec.code = rec.code or H.genCode(rec)
		rec.retShown = rec.ret ~= nil
		spy.box.Text = rec.code
		local g = spy.selGroup
		local pos = (g and #g.recs > 1) and ("   [" .. (spy.gi or 1) .. "/" .. #g.recs .. "]") or ""
		local extra = ""
		if rec.ret then extra = extra .. "   returned " .. rec.ret.n end
		if rec.script then extra = extra .. "   script " .. rec.script.Name end
		if g and g.recent and g.recent > 0 then extra = extra .. string.format("   %.1f/s", g.recent / 5) end
		spy.info.Text = (rec.dir == "in" and "<- " or "") .. rec.name .. "   :" .. rec.method .. "   (" .. rec.args.n .. " arg"
			.. (rec.args.n == 1 and "" or "s") .. ")" .. pos .. extra
		refreshBar()
	end
	local function selectGroup(g)
		spy.selKey, spy.selGroup, spy.gi = g.key, g, 1
		showRec(g.latest)
		rebuildLog()
	end
	local function clearSel()
		spy.sel, spy.selKey, spy.selGroup, spy.gi, spy.argRec = nil, nil, nil, nil, nil
		spy.box.Text = ""
		spy.info.Text = "No call selected"
	end
	local function browse(delta)
		local g = spy.selGroup
		if not g or #g.recs < 2 then return end
		spy.gi = math.clamp((spy.gi or 1) + delta, 1, #g.recs)
		showRec(g.recs[spy.gi])
	end

	local function groupLabel(g)
		local rec = g.latest
		local kind = rec.dir == "in" and "In" or (rec.method == "FireServer" and "Fire" or "Invoke")
		local l = (rec.dir == "in" and "<- " or "") .. rec.name .. "   " .. kind .. "   " .. rec.args.n .. "a"
		if rec.ret then l = l .. "   ret" end
		if g.count > 1 then l = l .. "   x" .. g.count end
		if g.recent >= 2 then l = l .. string.format("   %.1f/s", g.recent / 5) end
		if rec.rewritten then l = l .. "   [rw]" end
		if rec.dir ~= "in" and CONFIG.SpyBlocked[rec.name] then l = "[blocked] " .. l end
		return l
	end
	function rebuildLog()
		for _, c in ipairs(spy.logScroll:GetChildren()) do
			if c:IsA("TextButton") or c.Name == "Hint" then c:Destroy() end
		end
		local groups = H.buildGroups()
		spy.groups = groups
		if spy.selKey ~= nil then
			local found
			for _, g in ipairs(groups) do
				if g.key == spy.selKey then
					found = g
					break
				end
			end
			spy.selGroup = found
			if found and spy.sel then
				for idx, r in ipairs(found.recs) do
					if r == spy.sel then
						spy.gi = idx
						break
					end
				end
			end
		end
		if #groups == 0 then
			mk("TextLabel", {
				Name = "Hint", LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 70), BackgroundTransparency = 1, TextWrapped = true,
				TextYAlignment = Enum.TextYAlignment.Top, TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.Gotham, TextSize = 10,
				TextColor3 = C.sub,
				Text = (#spy.log > 0 and "Nothing matches the filter.\n\n" or "Waiting for remote calls. Attack or use a skill in the game and they will show up here.\n\n")
					.. "Hook: " .. (spy.hookInfo or "not installed yet"),
			}, spy.logScroll)
		end
		local ts = math.min(CONFIG.SpyFont, 13)
		for idx = 1, math.min(#groups, 80) do
			local g = groups[idx]
			local b = mk("TextButton", {
				LayoutOrder = idx, Size = UDim2.new(1, 0, 0, 22), BackgroundColor3 = (spy.selKey ~= nil and g.key == spy.selKey) and C.accent or C.card,
				BorderSizePixel = 0, AutoButtonColor = false, Font = Enum.Font.Gotham, TextSize = ts, TextColor3 = C.text, Text = groupLabel(g),
				TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
			}, spy.logScroll)
			corner(b, 4)
			mk("UIPadding", { PaddingLeft = UDim.new(0, 6) }, b)
			table.insert(connections, b.Activated:Connect(function() selectGroup(g) end))
		end
	end

	-- helpers for the other views
	local ord = 0
	local function clearView()
		for _, c in ipairs(spy.viewScroll:GetChildren()) do
			if c:IsA("GuiObject") then c:Destroy() end
		end
		ord = 0
	end
	local function vbtn(text, h, color)
		ord = ord + 1
		local b = mkButton(spy.viewScroll, text, UDim2.new(1, 0, 0, h or 24), nil, color or C.cardHi, 11)
		b.LayoutOrder = ord
		return b
	end
	local function vlabel(text, h)
		ord = ord + 1
		return mk("TextLabel", {
			LayoutOrder = ord, Size = UDim2.new(1, 0, 0, h or 28), BackgroundTransparency = 1, Text = text, TextWrapped = true,
			Font = Enum.Font.Gotham, TextSize = 10, TextColor3 = C.sub, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
		}, spy.viewScroll)
	end
	local function vbox(placeholder, text)
		ord = ord + 1
		local b = mkBox(spy.viewScroll, placeholder, UDim2.new(1, 0, 0, 24), nil, 11)
		b.LayoutOrder = ord
		b.ClearTextOnFocus = false
		b.Text = text or ""
		return b
	end
	local function vrow(h)
		ord = ord + 1
		local r = mk("Frame", { LayoutOrder = ord, Size = UDim2.new(1, 0, 0, h or 24), BackgroundColor3 = C.card, BorderSizePixel = 0 }, spy.viewScroll)
		corner(r, 4)
		return r
	end
	local function rowLabel(row, text, rightPad)
		return mk("TextLabel", {
			Size = UDim2.new(1, -rightPad, 1, 0), Position = UDim2.fromOffset(6, 0), BackgroundTransparency = 1, Text = text, Font = Enum.Font.Gotham,
			TextSize = 11, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
		}, row)
	end

	function rebuildNames()
		local kind = spy.view
		local tbl = kind == "blk" and CONFIG.SpyBlocked or (kind == "wht" and CONFIG.SpyWhite or CONFIG.SpyExcluded)
		local verb = kind == "blk" and "Unblock" or (kind == "wht" and "Remove" or "Unexclude")
		clearView()
		if kind == "wht" then
			local modeB = vbtn(CONFIG.SpyWhiteOn and "Whitelist mode: ON (only listed remotes are logged)" or "Whitelist mode: OFF (tap to log only listed remotes)", 24,
				CONFIG.SpyWhiteOn and C.accent or C.cardHi)
			table.insert(connections, modeB.Activated:Connect(function()
				CONFIG.SpyWhiteOn = not CONFIG.SpyWhiteOn
				saveSettings()
				rebuildNames()
				refreshBar()
			end))
			local addB = vbtn("Add selected remote", 24)
			table.insert(connections, addB.Activated:Connect(function()
				if not spy.sel then say("Select a call first") return end
				CONFIG.SpyWhite[spy.sel.name] = true
				saveSettings()
				rebuildNames()
				refreshBar()
				say("Whitelisted " .. spy.sel.name)
			end))
		end
		local names = {}
		for nm in pairs(tbl) do names[#names + 1] = nm end
		table.sort(names)
		local allBtn = vbtn(verb .. " all (" .. #names .. ")", 24)
		table.insert(connections, allBtn.Activated:Connect(function()
			table.clear(tbl)
			saveSettings()
			rebuildNames()
			refreshBar()
			say(verb .. " done for all remotes")
		end))
		for _, nm in ipairs(names) do
			local row = vrow(24)
			rowLabel(row, nm, 84)
			local ub = mkButton(row, verb, UDim2.fromOffset(74, 20), UDim2.new(1, -78, 0, 2), C.cardHi, 10)
			table.insert(connections, ub.Activated:Connect(function()
				tbl[nm] = nil
				saveSettings()
				rebuildNames()
				refreshBar()
				say(verb .. ": " .. nm)
			end))
		end
		if #names == 0 then vlabel(kind == "blk" and "No blocked remotes" or (kind == "wht" and "Whitelist is empty" or "No excluded remotes"), 18) end
	end

	function rebuildMacros()
		clearView()
		local saveSel = vbtn("Save selected call as a macro", 24)
		table.insert(connections, saveSel.Activated:Connect(function()
			if not spy.sel then say("Select a call first") return end
			if #CONFIG.SpyMacros >= 30 then say("Macro limit reached (30)") return end
			table.insert(CONFIG.SpyMacros, { name = "Macro " .. (#CONFIG.SpyMacros + 1) .. " (" .. spy.sel.name .. ")", steps = { H.stepFromRec(spy.sel, 0) } })
			saveSettings()
			rebuildMacros()
			refreshBar()
			say("Saved macro")
		end))
		local recB = vbtn(spy.recording and ("Stop recording (" .. #spy.recording.recs .. " calls)") or "Record a sequence (performs timing too)", 24,
			spy.recording and C.accent or C.cardHi)
		table.insert(connections, recB.Activated:Connect(function()
			if spy.recording then
				local rc = spy.recording
				spy.recording = nil
				if #rc.recs == 0 then
					say("Nothing was recorded")
				elseif #CONFIG.SpyMacros < 30 then
					local steps = {}
					for i, ent in ipairs(rc.recs) do steps[i] = H.stepFromRec(ent.rec, i == 1 and 0 or ent.delay) end
					table.insert(CONFIG.SpyMacros, { name = "Rec " .. (#CONFIG.SpyMacros + 1) .. " (" .. #steps .. " calls)", steps = steps })
					saveSettings()
					say("Saved a macro with " .. #steps .. " calls")
				end
			else
				spy.recording = { recs = {}, last = os.clock() }
				if not spy.on then spy.on = true end
				say("Recording: do the actions in the game, then tap Stop")
			end
			rebuildMacros()
			refreshBar()
		end))
		vlabel("Run uses the Repeat count. Tap Run again while a macro is running to stop it.", 26)
		for i, m in ipairs(CONFIG.SpyMacros) do
			local total = 0
			for _, st in ipairs(m.steps) do total = total + (st.delay or 0) end
			local row = vrow(24)
			rowLabel(row, m.name .. "  (" .. #m.steps .. ", " .. string.format("%.1fs", total) .. ")", 120)
			local rb = mkButton(row, spy.macroRunning and "Stop" or "Run", UDim2.fromOffset(52, 20), UDim2.new(1, -112, 0, 2), C.accent, 10)
			table.insert(connections, rb.Activated:Connect(function()
				H.runMacro(m, CONFIG.SpyRepeat)
				task.delay(0.1, function() rebuildMacros() end)
			end))
			local db = mkButton(row, "Del", UDim2.fromOffset(50, 20), UDim2.new(1, -56, 0, 2), C.cardHi, 10)
			table.insert(connections, db.Activated:Connect(function()
				table.remove(CONFIG.SpyMacros, i)
				saveSettings()
				rebuildMacros()
				refreshBar()
			end))
		end
		if #CONFIG.SpyMacros == 0 then vlabel("No macros yet", 18) end
	end

	function rebuildRules()
		clearView()
		vlabel("Rewrite changes a call's arguments before it is sent, while the spy is recording. The expression can use: target (nearest enemy part), myroot, args, remote.", 40)
		local idxBox = vbox("arg # (0 = every Vector3 / CFrame / part automatically)", spy.ruleIdx or "1")
		local exprBox = vbox("expression, e.g. target.Position", spy.ruleExpr or "target.Position")
		table.insert(connections, idxBox:GetPropertyChangedSignal("Text"):Connect(function() spy.ruleIdx = idxBox.Text end))
		table.insert(connections, exprBox:GetPropertyChangedSignal("Text"):Connect(function() spy.ruleExpr = exprBox.Text end))
		ord = ord + 1
		local pr = mk("Frame", { LayoutOrder = ord, Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1 }, spy.viewScroll)
		mk("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, pr)
		for i, p in ipairs({ { "Position", "target.Position", "1" }, { "CFrame", "target.CFrame", "1" }, { "Part", "target", "1" }, { "Auto (0)", "", "0" } }) do
			local b = mkButton(pr, p[1], UDim2.new(0.25, -3, 1, 0), nil, C.cardHi, 10)
			b.LayoutOrder = i
			table.insert(connections, b.Activated:Connect(function()
				idxBox.Text, exprBox.Text = p[3], p[2]
			end))
		end
		local addB = vbtn("Add rule for the selected remote", 24, C.accent)
		table.insert(connections, addB.Activated:Connect(function()
			if not spy.sel then say("Select a call first") return end
			local idx = math.clamp(math.floor(tonumber(idxBox.Text) or 1), 0, 30)
			local expr = exprBox.Text
			if idx > 0 and expr:match("^%s*$") then say("Type an expression first") return end
			if #CONFIG.SpyRules >= 30 then say("Rule limit reached (30)") return end
			table.insert(CONFIG.SpyRules, { name = spy.sel.name, idx = idx, expr = expr:sub(1, 200), on = true })
			saveSettings()
			rebuildRules()
			refreshBar()
			say("Rule added for " .. spy.sel.name)
		end))
		for i, rule in ipairs(CONFIG.SpyRules) do
			local row = vrow(24)
			rowLabel(row, rule.name .. "  #" .. rule.idx .. (rule.idx > 0 and ("  = " .. rule.expr) or "  auto"), 120)
			local tb = mkButton(row, rule.on and "On" or "Off", UDim2.fromOffset(52, 20), UDim2.new(1, -112, 0, 2), rule.on and C.accent or C.cardHi, 10)
			table.insert(connections, tb.Activated:Connect(function()
				rule.on = not rule.on
				saveSettings()
				rebuildRules()
			end))
			local db = mkButton(row, "Del", UDim2.fromOffset(50, 20), UDim2.new(1, -56, 0, 2), C.cardHi, 10)
			table.insert(connections, db.Activated:Connect(function()
				table.remove(CONFIG.SpyRules, i)
				saveSettings()
				rebuildRules()
				refreshBar()
			end))
		end
		if #CONFIG.SpyRules == 0 then vlabel("No rules yet", 18) end
	end

	function rebuildArgs()
		clearView()
		local rec = spy.sel
		if not rec then
			vlabel("Select a call in the log first, then open Args.", 30)
			return
		end
		if spy.argRec ~= rec then
			spy.argRec = rec
			spy.argExprs = {}
			for i = 1, rec.args.n do spy.argExprs[i] = H.serialize(rec.args[i], 1) end
		end
		vlabel(rec.name .. " :" .. rec.method .. "  - edit each argument as Lua, then Apply", 16)
		for i = 1, #spy.argExprs do
			local row = vrow(26)
			mk("TextLabel", {
				Size = UDim2.fromOffset(62, 26), Position = UDim2.fromOffset(4, 0), BackgroundTransparency = 1,
				Text = "[" .. i .. "] " .. (i <= rec.args.n and typeof(rec.args[i]) or "new"), Font = Enum.Font.Gotham, TextSize = 10, TextColor3 = C.sub,
				TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
			}, row)
			local tb = mkBox(row, "value", UDim2.new(1, -72, 0, 22), UDim2.fromOffset(68, 2), 11)
			tb.ClearTextOnFocus = false
			tb.Text = spy.argExprs[i]
			table.insert(connections, tb:GetPropertyChangedSignal("Text"):Connect(function() spy.argExprs[i] = tb.Text end))
		end
		local applyB = vbtn("Apply to the code box", 24, C.accent)
		table.insert(connections, applyB.Activated:Connect(function()
			local ex = {}
			for i, e in ipairs(spy.argExprs) do ex[i] = (e:match("^%s*$") and "nil" or e) end
			spy.box.Text = H.codeFrom(rec, ex, #ex)
			setView("log")
			say("Code updated. Press Run to send it.")
		end))
		local plusB = vbtn("+ add an argument", 24)
		table.insert(connections, plusB.Activated:Connect(function()
			spy.argExprs[#spy.argExprs + 1] = "nil"
			rebuildArgs()
		end))
		local minusB = vbtn("- remove the last argument", 24)
		table.insert(connections, minusB.Activated:Connect(function()
			spy.argExprs[#spy.argExprs] = nil
			rebuildArgs()
		end))
	end

	function setView(v)
		spy.view = v
		spy.logScroll.Visible = v == "log"
		spy.viewScroll.Visible = v ~= "log"
		if v == "log" then
			rebuildLog()
		elseif v == "mac" then
			rebuildMacros()
		elseif v == "rw" then
			rebuildRules()
		elseif v == "args" then
			rebuildArgs()
		else
			rebuildNames()
		end
		refreshBar()
	end
	local function toggleView(v) setView(spy.view == v and "log" or v) end

	-- header buttons
	local maxState
	table.insert(connections, closeB.Activated:Connect(function()
		win.Visible = false
		spy.on = false
		refreshBar()
	end))
	table.insert(connections, maxB.Activated:Connect(function()
		local ar = gui.AbsoluteSize
		if maxState then
			spy.w, spy.h = maxState.w, maxState.h
			win.Size = UDim2.fromOffset(spy.w, spy.h)
			win.Position = maxState.pos
			maxState = nil
		else
			maxState = { w = spy.w, h = spy.h, pos = win.Position }
			spy.w, spy.h = math.max(300, ar.X - 12), math.max(400, ar.Y - 12)
			win.Size = UDim2.fromOffset(spy.w, spy.h)
			win.Position = UDim2.fromOffset(6, 6)
		end
		layout()
		CONFIG.SpyW, CONFIG.SpyH = spy.w, spy.h
		saveSettings()
	end))
	local function setFont(delta)
		CONFIG.SpyFont = math.clamp(CONFIG.SpyFont + delta, 9, 16)
		spy.box.TextSize = CONFIG.SpyFont
		saveSettings()
		if spy.view == "log" then rebuildLog() end
		say("Text size " .. CONFIG.SpyFont)
	end
	table.insert(connections, bigB.Activated:Connect(function() setFont(1) end))
	table.insert(connections, smallB.Activated:Connect(function() setFont(-1) end))

	-- resizing by dragging the grip
	local resizing, rInput, rStart, rW, rH = false, nil, nil, 0, 0
	table.insert(connections, grip.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			resizing, rInput, rStart, rW, rH = true, i, i.Position, spy.w, spy.h
			i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End then
					resizing = false
					CONFIG.SpyW, CONFIG.SpyH = spy.w, spy.h
					saveSettings()
				end
			end)
		end
	end))
	table.insert(connections, UserInputService.InputChanged:Connect(function(i)
		if not resizing then return end
		local isTouch = rInput.UserInputType == Enum.UserInputType.Touch
		if (isTouch and i == rInput) or (not isTouch and i.UserInputType == Enum.UserInputType.MouseMovement) then
			local d = i.Position - rStart
			local ar = gui.AbsoluteSize
			spy.w = math.clamp(rW + d.X, 300, math.max(300, ar.X - 8))
			spy.h = math.clamp(rH + d.Y, 400, math.max(400, ar.Y - 8))
			win.Size = UDim2.fromOffset(spy.w, spy.h)
			layout()
		end
	end))

	-- toolbar buttons
	table.insert(connections, pauseB.Activated:Connect(function()
		spy.on = not spy.on
		refreshBar()
		say(spy.on and "Recording" or "Paused (blocking and rewriting are off while paused)")
	end))
	table.insert(connections, clearB.Activated:Connect(function()
		spy.log = {}
		spy.total, spy.names, spy.nameCount, spy.skipped = 0, {}, 0, 0
		clearSel()
		if spy.view == "log" then rebuildLog() end
	end))
	table.insert(connections, atkB.Activated:Connect(function()
		spy.attackOnly = not spy.attackOnly
		refreshBar()
		say(spy.attackOnly and "Only logging calls made within 1.5s of your attacks" or "Logging every call")
	end))
	table.insert(connections, viewB.Activated:Connect(function()
		CONFIG.SpyView = H.nextOf(K.SPY_VIEWS, CONFIG.SpyView)
		saveSettings()
		local msg = { List = "List: every call on its own row", Stack = "Stack: identical calls (same remote and arguments) are stacked", Name = "Name: all calls of the same remote are grouped" }
		say(msg[CONFIG.SpyView])
		if spy.view == "log" then rebuildLog() end
		refreshBar()
	end))
	table.insert(connections, excB.Activated:Connect(function() toggleView("exc") end))
	table.insert(connections, blkB.Activated:Connect(function() toggleView("blk") end))
	table.insert(connections, whtB.Activated:Connect(function() toggleView("wht") end))
	table.insert(connections, macB.Activated:Connect(function() toggleView("mac") end))
	table.insert(connections, rwB.Activated:Connect(function() toggleView("rw") end))
	table.insert(connections, argsB.Activated:Connect(function() toggleView("args") end))
	table.insert(connections, autoB.Activated:Connect(function()
		CONFIG.SpyAuto = not CONFIG.SpyAuto
		saveSettings()
		refreshBar()
		say(CONFIG.SpyAuto and "Auto: remotes firing over 20 times a second get excluded" or "Auto-exclude off")
	end))
	table.insert(connections, moreB.Activated:Connect(function()
		spy.more = not spy.more
		CONFIG.SpyMore = spy.more
		if spy.more then
			local ar = gui.AbsoluteSize
			spy.h = math.max(spy.h, math.min(500, math.max(400, ar.Y - 8)))
			win.Size = UDim2.fromOffset(spy.w, spy.h)
		end
		layout()
		saveSettings()
		refreshBar()
	end))
	table.insert(connections, inB.Activated:Connect(function()
		CONFIG.SpyIncoming = not CONFIG.SpyIncoming
		H.setIncoming(CONFIG.SpyIncoming)
		saveSettings()
		refreshBar()
		say(CONFIG.SpyIncoming and "Also logging calls the server sends to you" or "Incoming logging off")
	end))
	table.insert(connections, scrB.Activated:Connect(function()
		if not CONFIG.SpyScripts and type(getcallingscript) ~= "function" then
			say("This executor has no getcallingscript")
			return
		end
		CONFIG.SpyScripts = not CONFIG.SpyScripts
		saveSettings()
		refreshBar()
		say(CONFIG.SpyScripts and "Capturing the calling script (new calls only)" or "Script capture off")
	end))
	table.insert(connections, filterBox:GetPropertyChangedSignal("Text"):Connect(function()
		spy.filter = filterBox.Text:lower():match("^%s*(.-)%s*$")
		if spy.view == "log" then rebuildLog() end
	end))
	table.insert(connections, prevB.Activated:Connect(function() browse(-1) end))
	table.insert(connections, nextB.Activated:Connect(function() browse(1) end))

	-- action buttons
	table.insert(connections, copyB.Activated:Connect(function() copyText(spy.box.Text, copyB) end))
	table.insert(connections, pathB.Activated:Connect(function()
		if not spy.sel then say("Select a call first") return end
		copyText(H.instPath(spy.sel.remote), pathB)
	end))
	table.insert(connections, repB.Activated:Connect(function()
		CONFIG.SpyRepeat = H.nextOf(K.SPY_REPEATS, CONFIG.SpyRepeat)
		saveSettings()
		refreshBar()
	end))
	table.insert(connections, runB.Activated:Connect(function()
		local rec = spy.sel
		local code = spy.box.Text
		local n = CONFIG.SpyRepeat
		if rec and code == rec.code then
			task.spawn(function()
				local fails = 0
				for _ = 1, n do
					local ok = H.execStep(H.stepFromRec(rec, 0))
					if not ok then fails = fails + 1 end
					if n > 1 then task.wait(0.03) end
				end
				say(fails == 0 and ("Replayed " .. rec.name .. (n > 1 and (" x" .. n) or "")) or ("Replay failed " .. fails .. " time(s)"))
			end)
		else
			local ls = loadstring or load
			if not ls then say("This executor has no loadstring, so edited code can't run") return end
			if code:match("^%s*$") then say("Nothing to run") return end
			local f, err = ls(code)
			if not f then say("Code error: " .. tostring(err)) return end
			task.spawn(function()
				local failed
				for _ = 1, n do
					spy.replaying = true
					local ok, e = pcall(f)
					spy.replaying = false
					if not ok then
						failed = e
						break
					end
					if n > 1 then task.wait(0.03) end
				end
				say(failed == nil and ("Ran your code" .. (n > 1 and (" x" .. n) or "")) or ("Run error: " .. tostring(failed)))
			end)
		end
	end))
	table.insert(connections, exclB.Activated:Connect(function()
		local rec = spy.sel
		if not rec then say("Select a call first") return end
		CONFIG.SpyExcluded[rec.name] = true
		for i = #spy.log, 1, -1 do
			if spy.log[i].name == rec.name then table.remove(spy.log, i) end
		end
		clearSel()
		saveSettings()
		if spy.view == "log" then rebuildLog() end
		refreshBar()
		say("Excluded " .. rec.name .. " (see Excluded to undo)")
	end))
	table.insert(connections, blockB.Activated:Connect(function()
		local rec = spy.sel
		if not rec then say("Select a call first") return end
		if rec.dir == "in" then say("Incoming calls can't be blocked") return end
		if CONFIG.SpyBlocked[rec.name] then
			CONFIG.SpyBlocked[rec.name] = nil
			say("Unblocked " .. rec.name)
		else
			CONFIG.SpyBlocked[rec.name] = true
			say("Blocking " .. rec.name .. " while the spy is recording")
		end
		saveSettings()
		refreshBar()
		if spy.view == "log" then rebuildLog() end
	end))
	table.insert(connections, delB.Activated:Connect(function()
		local g = spy.selGroup
		if not g then say("Select a call first") return end
		local kill = {}
		for _, r in ipairs(g.recs) do kill[r] = true end
		for i = #spy.log, 1, -1 do
			if kill[spy.log[i]] then table.remove(spy.log, i) end
		end
		clearSel()
		if spy.view == "log" then rebuildLog() end
		say("Deleted " .. #g.recs .. " log(s)")
	end))
	table.insert(connections, allB.Activated:Connect(function()
		local groups = spy.groups or H.buildGroups()
		local out = {}
		for i = 1, math.min(#groups, 40) do
			local g = groups[i]
			local rec = g.latest
			rec.code = rec.code or H.genCode(rec)
			out[#out + 1] = "-- " .. rec.name .. (g.count > 1 and (" (x" .. g.count .. ")") or "") .. "\n" .. rec.code
		end
		if #out == 0 then say("Nothing to copy") return end
		copyText(table.concat(out, "\n\n"), allB)
	end))
	table.insert(connections, diffB.Activated:Connect(function()
		local g = spy.selGroup
		if not g or #g.recs < 2 then say("Diff needs a group with 2+ calls (set View to Name)") return end
		local gi = math.clamp(spy.gi or 1, 1, #g.recs - 1)
		spy.box.Text = H.diffText(g.recs[gi], g.recs[gi + 1])
		say("Diff of call " .. gi .. " vs " .. (gi + 1) .. " in this group")
	end))
	table.insert(connections, decB.Activated:Connect(function()
		local scr = spy.sel and spy.sel.script
		if not scr then say("No calling script captured. Turn Script ON, then make the call again.") return end
		if type(decompile) ~= "function" then say("This executor has no decompile") return end
		say("Decompiling...")
		task.spawn(function()
			local ok, src = pcall(decompile, scr)
			if ok then
				spy.box.Text = "-- decompiled " .. H.instPath(scr) .. "\n" .. tostring(src)
				say("Decompiled " .. scr.Name)
			else
				say("Decompile failed: " .. tostring(src))
			end
		end)
	end))
	table.insert(connections, cscB.Activated:Connect(function()
		local scr = spy.sel and spy.sel.script
		if not scr then say("No calling script captured. Turn Script ON, then make the call again.") return end
		copyText(H.instPath(scr), cscB)
	end))
	table.insert(connections, saveB.Activated:Connect(function()
		if not spy.sel then say("Select a call first") return end
		if #CONFIG.SpyMacros >= 30 then say("Macro limit reached (30)") return end
		table.insert(CONFIG.SpyMacros, { name = "Macro " .. (#CONFIG.SpyMacros + 1) .. " (" .. spy.sel.name .. ")", steps = { H.stepFromRec(spy.sel, 0) } })
		saveSettings()
		refreshBar()
		say("Saved as a macro (see Macros)")
	end))
	table.insert(connections, expB.Activated:Connect(function()
		local groups = spy.groups or H.buildGroups()
		local out = { "-- exported by Hitbox Expander remote spy" }
		for i = 1, math.min(#groups, 200) do
			local g = groups[i]
			local rec = g.latest
			rec.code = rec.code or H.genCode(rec)
			out[#out + 1] = "\n-- " .. rec.name .. (g.count > 1 and (" (x" .. g.count .. ")") or "") .. "\n" .. rec.code
		end
		if #out == 1 then say("Nothing to export") return end
		local text = table.concat(out, "\n")
		if type(writefile) == "function" and pcall(writefile, K.EXPORT_FILE, text) then
			say("Exported " .. (#out - 1) .. " entries to " .. K.EXPORT_FILE)
		else
			copyText(text, expB)
			say("No writefile here, copied the export instead")
		end
	end))
	table.insert(connections, impB.Activated:Connect(function()
		if type(readfile) ~= "function" or type(isfile) ~= "function" or not isfile(K.EXPORT_FILE) then
			say("No " .. K.EXPORT_FILE .. " found. Export first.")
			return
		end
		local ok, text = pcall(readfile, K.EXPORT_FILE)
		if not ok then say("Could not read the file") return end
		clearSel()
		spy.box.Text = text
		setView("log")
		say("Imported into the code box. Edit it or press Run.")
	end))

	task.spawn(function()
		while alive do
			task.wait(0.4)
			if spy.win and spy.win.Visible then
				if spy.saveNeeded then
					spy.saveNeeded = false
					saveSettings()
				end
				if spy.dirty then
					spy.dirty = false
					if spy.view == "log" then rebuildLog() end
				end
				if spy.macroDirty then
					spy.macroDirty = false
					if spy.view == "mac" then rebuildMacros() end
				end
				local s = spy.sel
				if s and s.ret and not s.retShown then
					s.retShown = true
					if spy.box.Text == s.code then
						s.code = H.genCode(s)
						spy.box.Text = s.code
						spy.info.Text = spy.info.Text .. "   returned " .. s.ret.n
					end
				end
				if os.clock() > (spy.statusUntil or 0) then
					if spy.notice and os.clock() < (spy.noticeUntil or 0) then
						spy.status.Text = spy.notice
					else
						spy.status.Text = "Calls " .. spy.total .. "   Remotes " .. spy.nameCount .. "   Skipped " .. spy.skipped
							.. (spy.autoCount > 0 and ("   Auto-excluded " .. spy.autoCount) or "")
							.. (spy.recording and ("   REC " .. #spy.recording.recs) or "")
					end
				end
				refreshBar()
			end
		end
	end)
	refreshBar()
end

local function buildSpy()
	if spy.win then return true end
	local ok, err = pcall(buildSpyInner)
	if not ok then
		if spy.win then pcall(function() spy.win:Destroy() end) end
		spy.win = nil
		showStatus("Remote spy window failed: " .. tostring(err), 10)
		return false
	end
	return true
end

local function toggleSpy()
	if not buildSpy() then return end
	local show = not spy.win.Visible
	spy.win.Visible = show
	spy.on = show
	spy.dirty = true
	if show then
		if CONFIG.SpyIncoming and not spy.inActive then H.setIncoming(true) end
		if not ensureHook() then
			spy.status.Text = "Could not install the hook: " .. tostring(spy.hookInfo)
			spy.statusUntil = os.clock() + 10
		else
			spy.status.Text = ""
		end
	end
end

