-- code generation for logged calls
function H.isIdent(s) return s:match("^[%a_][%w_]*$") ~= nil end
function H.instPath(i)
	if i == nil then return "nil" end
	if i == game then return "game" end
	if i == player then return 'game:GetService("Players").LocalPlayer' end
	local ch = player.Character
	local chain, cur = {}, i
	while cur and cur ~= game and cur ~= ch do
		table.insert(chain, 1, cur)
		cur = cur.Parent
	end
	local s
	if ch and cur == ch then
		s = 'game:GetService("Players").LocalPlayer.Character'
	elseif cur ~= game then
		return "nil --[[" .. i.Name .. " (not parented)]]"
	else
		local root = chain[1]
		local isService = false
		pcall(function() isService = game:GetService(root.ClassName) == root end)
		if isService then
			s = 'game:GetService("' .. root.ClassName .. '")'
		else
			s = "game:FindFirstChild(" .. string.format("%q", root.Name) .. ")"
		end
		table.remove(chain, 1)
	end
	for _, inst in ipairs(chain) do
		local nm = inst.Name
		if H.isIdent(nm) then s = s .. "." .. nm else s = s .. "[" .. string.format("%q", nm) .. "]" end
	end
	return s
end
function H.serialize(v, depth)
	depth = depth or 0
	local t = typeof(v)
	if t == "string" then
		return string.format("%q", v)
	elseif t == "number" then
		if v ~= v then return "0/0" end
		if v == math.huge then return "math.huge" end
		if v == -math.huge then return "-math.huge" end
		return tostring(v)
	elseif t == "boolean" or t == "nil" then
		return tostring(v)
	elseif t == "Instance" then
		return H.instPath(v)
	elseif t == "Vector3" then
		return ("Vector3.new(%s, %s, %s)"):format(v.X, v.Y, v.Z)
	elseif t == "Vector2" then
		return ("Vector2.new(%s, %s)"):format(v.X, v.Y)
	elseif t == "CFrame" then
		local c = { v:GetComponents() }
		for i = 1, #c do c[i] = tostring(c[i]) end
		return "CFrame.new(" .. table.concat(c, ", ") .. ")"
	elseif t == "Color3" then
		return ("Color3.new(%s, %s, %s)"):format(v.R, v.G, v.B)
	elseif t == "UDim2" then
		return ("UDim2.new(%s, %s, %s, %s)"):format(v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset)
	elseif t == "UDim" then
		return ("UDim.new(%s, %s)"):format(v.Scale, v.Offset)
	elseif t == "EnumItem" then
		return tostring(v)
	elseif t == "BrickColor" then
		return ("BrickColor.new(%q)"):format(v.Name)
	elseif t == "Ray" then
		return "Ray.new(" .. H.serialize(v.Origin, depth + 1) .. ", " .. H.serialize(v.Direction, depth + 1) .. ")"
	elseif t == "table" then
		if depth >= 4 then return "{}" end
		local parts, used, count = {}, {}, 0
		for i = 1, #v do
			if count >= 40 then break end
			parts[#parts + 1] = H.serialize(v[i], depth + 1)
			used[i] = true
			count = count + 1
		end
		for k, val in pairs(v) do
			if not used[k] and count < 40 then
				local ks = (type(k) == "string" and H.isIdent(k)) and k or ("[" .. H.serialize(k, depth + 1) .. "]")
				parts[#parts + 1] = ks .. " = " .. H.serialize(val, depth + 1)
				count = count + 1
			end
		end
		return "{" .. table.concat(parts, ", ") .. "}"
	end
	return "nil --[[" .. t .. "]]"
end
function H.codeFrom(rec, exprs, n)
	local path = H.instPath(rec.remote)
	local call
	if rec.dir == "in" then
		call = "firesignal(" .. path .. ".OnClientEvent" .. (n > 0 and (", unpack(args, 1, " .. n .. ")") or "") .. ")"
	else
		call = path .. ":" .. rec.method .. "(" .. (n > 0 and ("unpack(args, 1, " .. n .. ")") or "") .. ")"
	end
	if n == 0 then return call end
	local lines = { "local args = {" }
	for i = 1, n do lines[#lines + 1] = "\t" .. exprs[i] .. (i < n and "," or "") end
	lines[#lines + 1] = "}"
	lines[#lines + 1] = call
	return table.concat(lines, "\n")
end
function H.genCode(rec)
	local exprs = {}
	for i = 1, rec.args.n do exprs[i] = H.serialize(rec.args[i], 1) end
	local code = H.codeFrom(rec, exprs, rec.args.n)
	if rec.ret then
		local r = {}
		for i = 1, rec.ret.n do r[i] = H.serialize(rec.ret[i], 2) end
		local txt = table.concat(r, ", ")
		if #txt > 400 then txt = txt:sub(1, 400) .. "..." end
		code = code .. "\n-- returned (" .. rec.ret.n .. "): " .. txt
	end
	return code
end

-- macros (saved sequences of calls with their delays)
local macroRec = setmetatable({}, { __mode = "k" })
function H.stepFromRec(rec, delay)
	rec.code = rec.code or H.genCode(rec)
	local step = { code = rec.code, delay = delay }
	macroRec[step] = rec
	return step
end
function H.execStep(step)
	local rec = macroRec[step]
	local ok = true
	spy.replaying = true
	if rec and rec.dir ~= "in" then
		ok = pcall(function()
			if rec.method == "InvokeServer" then
				task.spawn(function()
					pcall(function() rec.remote:InvokeServer(table.unpack(rec.args, 1, rec.args.n)) end)
				end)
			else
				rec.remote:FireServer(table.unpack(rec.args, 1, rec.args.n))
			end
		end)
	else
		local ls = loadstring or load
		local f = ls and ls(step.code)
		ok = f ~= nil and pcall(f)
	end
	spy.replaying = false
	return ok
end
function H.runMacro(m, times)
	if spy.macroRunning then
		spy.macroStop = true
		return
	end
	spy.macroRunning, spy.macroStop = true, false
	task.spawn(function()
		for _ = 1, times do
			for _, step in ipairs(m.steps) do
				if spy.macroStop or not alive then break end
				if step.delay and step.delay > 0 then task.wait(math.min(step.delay, 5)) end
				H.execStep(step)
			end
			if spy.macroStop or not alive then break end
		end
		spy.macroRunning = false
		spy.macroDirty = true
	end)
end

function H.shortVal(v)
	local t = H.serialize(v, 3)
	if #t > 70 then t = t:sub(1, 70) .. "..." end
	return t
end
-- compares two logged calls argument by argument
function H.diffText(newer, older)
	local lines = { "-- diff: selected call (new) vs the one before it (old)" }
	local n = math.max(newer.args.n, older.args.n)
	for i = 1, n do
		local a, b = H.shortVal(newer.args[i]), H.shortVal(older.args[i])
		if a == b then
			lines[#lines + 1] = "-- [" .. i .. "] same:    " .. a
		else
			lines[#lines + 1] = "-- [" .. i .. "] changed: " .. b .. "  ->  " .. a
		end
	end
	return table.concat(lines, "\n")
end

