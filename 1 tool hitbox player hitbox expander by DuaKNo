local function updateStatus()
	if not (ui.status and ui.status.Parent) then return end
	local tool = heldTool()
	if ui.sizeLabel then
		ui.sizeLabel.Text = (CONFIG.PerTool and tool) and ("Size for: " .. tool.Name .. "  (this tool only)") or "Size for: all tools"
	end
	if ui.box and not ui.box:IsFocused() then
		local t = tostring(toolSizeFor(tool))
		if ui.box.Text ~= t then ui.box.Text = t end
	end
	if ui.stats then
		ui.stats.Text = "Auto-hit bursts: " .. touchBursts .. "     Damage seen: " .. hitsSeen
		ui.log.Text = #hitLog > 0 and table.concat(hitLog, "\n") or "No damage seen yet. Attack an enemy to fill the hit log."
	end
	if statusMsg and os.clock() < statusUntil then
		ui.status.Text = statusMsg
		return
	end
	local n = 0
	for _ in pairs(parts) do n = n + 1 end
	local txt
	if autoPaused then
		txt = "Paused for respawn..."
	elseif not CONFIG.Enabled then
		txt = "Hitbox off"
	elseif tool then
		txt = "Holding: " .. tool.Name .. "  |  " .. n .. " parts"
	else
		txt = "No tool held (moves still work)"
	end
	if lockedModel then txt = txt .. "  |  Locked: " .. lockedModel.Name end
	if CONFIG.TargetMode ~= "Off" then
		txt = txt .. "  |  Enemy hitbox: " .. (enemyBoxActive() and tostring(tcount) or "waiting")
	end
	if not hasFTI then txt = txt .. "  |  Auto hit N/A" end
	ui.status.Text = txt
end

table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == CONFIG.ToggleKey then
		setEnabled(not CONFIG.Enabled)
		return
	end
	if not processed and input.KeyCode == CONFIG.ForceKey then
		forceNow()
		return
	end
	if not processed and input.KeyCode == CONFIG.CycleKey then
		CONFIG.TargetMode = K.TMODES[(table.find(K.TMODES, CONFIG.TargetMode) or 1) % #K.TMODES + 1]
		updateTargets()
		showStatus("Enemy hitbox: " .. CONFIG.TargetMode, 3)
		refreshUI()
		return
	end
	if not processed and input.KeyCode == CONFIG.HitKey then
		if hasFTI then
			CONFIG.ForceTouch = not CONFIG.ForceTouch
			showStatus("Auto hit: " .. (CONFIG.ForceTouch and "ON" or "OFF"), 3)
			refreshUI()
		end
		return
	end
	if not processed and input.KeyCode == CONFIG.SafeKey then
		setSafe(not CONFIG.Safe)
		return
	end
	if not processed and input.KeyCode == CONFIG.LockKey then
		lockTarget()
		return
	end
	if not (CONFIG.Enabled and CONFIG.Moves) then return end
	if UserInputService:GetFocusedTextBox() then return end
	local ut = input.UserInputType
	local isClick = false
	if ut == Enum.UserInputType.Keyboard then
		if MOVE_KEYS[input.KeyCode] then return end
	elseif ut == Enum.UserInputType.MouseButton1 or ut == Enum.UserInputType.MouseButton2 or ut == Enum.UserInputType.MouseButton3 then
		isClick = true
	elseif ut == Enum.UserInputType.Touch then
		isClick = true
		local cam = workspace.CurrentCamera
		if cam then
			local vs = cam.ViewportSize

			if input.Position.X < vs.X * 0.4 and input.Position.Y > vs.Y * 0.4 then return end
		end
	else
		return
	end
	if not held[input] then
		held[input] = true
		heldCount = heldCount + 1
	end
	task.defer(function()
		if os.clock() - panelTouch < 0.25 then return end
		lastActivate = os.clock()
		pcall(updateTargets)
		actionBurst()
	end)
end))

table.insert(connections, UserInputService.InputEnded:Connect(function(input)
