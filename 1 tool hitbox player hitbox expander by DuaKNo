	task.spawn(function() hookAnimations(ch) end)
	lockedModel = nil
	if CONFIG.AutoPause and CONFIG.Enabled then
		setEnabled(false)
		autoPaused = true
		task.delay(2.5, function()
			if alive and autoPaused then
				autoPaused = false
				setEnabled(true)
			end
		end)
	end
end))

local accScan, accProj, accClick, accRay, accObj, accTele = 0, 0, 0, 0, 0, 0
local simTick = 0

-- PICK MODE: tap a part in the world to add it to the breakable-objects list by hand
table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
	if not (pickMode and alive) or processed then return end
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
	local cam = workspace.CurrentCamera
	if not cam then return end
	local pos = input.Position
	local ray = cam:ViewportPointToRay(pos.X, pos.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = player.Character and { player.Character } or {}
	local ok, res = pcall(workspace.Raycast, workspace, ray.Origin, ray.Direction * 500, params)
	if not (ok and res and res.Instance) then return end
	local p = res.Instance
	if not H.pickedValid(p) then
		showStatus("Can't pick " .. p.Name .. " (it's part of a character or the terrain)", 3)
		return
	end
	if pickedObjects[p] then
		pickedObjects[p] = nil
		showStatus("Removed " .. p.Name .. " from picked objects (" .. H.pickedCount() .. " left)", 3)
	else
		pickedObjects[p] = true
		CONFIG.Objects = true
		showStatus("Picked " .. p.Name .. "  (" .. H.pickedCount() .. " picked, tap it again to remove)", 3)
	end
	refreshUI()
end))
table.insert(connections, RunService.Heartbeat:Connect(function(dt)
	accScan = accScan + dt
	accProj = accProj + dt
	accClick = accClick + dt
	if CONFIG.RayAssist then
		accRay = accRay + dt
		if accRay >= 0.08 then
			accRay = 0
			pcall(H.refreshRayTargets)
		end
	end
	if CONFIG.Objects or next(oparts) then
		accObj = accObj + dt
		if accObj >= (CONFIG.ObjMode == "Aim" and 0.1 or 0.6) then
			accObj = 0
			pcall(H.refreshObjects)
		end
	end
	if CONFIG.TeleportMode then
		accTele = accTele + dt
		if accTele >= 0.03 then
			accTele = 0
			pcall(H.teleportTick)
		end
	end
	if CONFIG.AutoClick and accClick >= (CONFIG.Rapid and CONFIG.ClickGap * 0.5 or CONFIG.ClickGap) then
		accClick = 0
		pcall(H.autoClickStep)
	end
	avgDt = avgDt * 0.9 + dt * 0.1
	if CONFIG.ReachRing or ring then pcall(updateRing) end
	if accProj >= (avgDt > 0.04 and 0.25 or 0.1) then
		accProj = 0
		if CONFIG.TargetMode ~= "Off" or next(tparts) then pcall(updateTargets) end
		if CONFIG.Objects or next(oparts) then pcall(H.updateObjects) end
		if CONFIG.Safe then pcall(guardSelf) end
		if CONFIG.Enabled then
			pcall(enforce)
			if CONFIG.Throwables or CONFIG.Moves then pcall(projectileLoop) end
		end
	end
	if accScan >= 0.25 then
		accScan = 0
		if CONFIG.Enabled then pcall(scan) end
		pcall(trackHits)
		pcall(H.lagStep)
		pcall(updateStatus)
		simTick = simTick + 1
		if CONFIG.SimRadius and simTick % 8 == 0 then applySim(true) end
		if CONFIG.ShowOwners and simTick % 8 == 0 then applyOwners(true) end
	end
end))
pcall(updateStatus)

local function cleanup()
	alive = false
	restoreAll()
	restoreTargets()
	clearBars()
	pcall(H.clearEsp)
	if espGui then pcall(function() espGui:Destroy() end) end
	if lag.saved then pcall(H.lagRestore) end
	env.HBX_NC = nil
	pcall(H.restoreObjects)
	pcall(H.teleportRestoreAll, teleEnemy)
	pcall(H.teleportRestoreAll, teleObj)
	pickMode = false
	pcall(H.setIncoming, false)
	if CONFIG.ShowOwners then applyOwners(false) end
	for part, rec in pairs(projectiles) do
		if rec.orig and part.Parent then pcall(function() part.Size = rec.orig end) end
	end
	if CONFIG.SimRadius then applySim(false) end
	for tool in pairs(hooked) do unhookTool(tool) end
	for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
	table.clear(connections)
	table.clear(projectiles)
	table.clear(humanoids)
	if ring then pcall(function() ring:Destroy() end) end
	if gui then pcall(function() gui:Destroy() end) end
end

