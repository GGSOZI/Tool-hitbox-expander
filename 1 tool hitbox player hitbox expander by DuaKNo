-- grouping helpers for the spy list
function H.sigOf(rec)
	if rec.sig then return rec.sig end
	local parts = {}
	for i = 1, rec.args.n do parts[i] = H.serialize(rec.args[i], 2) end
	rec.sig = (rec.dir or "out") .. "|" .. rec.method .. "|" .. table.concat(parts, ",")
	return rec.sig
end
function H.buildGroups()
	local mode = CONFIG.SpyView
	local filt = spy.filter
	local nowT = os.clock()
	local groups, byKey = {}, {}
	for i = #spy.log, 1, -1 do
		local rec = spy.log[i]
		local pass = filt == ""
		if not pass then
			if rec.name:lower():find(filt, 1, true) then
				pass = true
			else
				rec.sigl = rec.sigl or H.sigOf(rec):lower()
				pass = rec.sigl:find(filt, 1, true) ~= nil
			end
		end
		if pass then
			local key
			if mode == "Stack" then
				key = rec.name .. "|" .. H.sigOf(rec)
			elseif mode == "Name" then
				key = (rec.dir or "out") .. "|" .. rec.name .. "|" .. rec.method
			else
				key = rec
			end
			local g = byKey[key]
			if not g then
				g = { key = key, latest = rec, recs = {}, count = 0, recent = 0 }
				byKey[key] = g
				groups[#groups + 1] = g
			end
			g.count = g.count + 1
			g.recs[#g.recs + 1] = rec
			if nowT - rec.t <= 5 then g.recent = g.recent + 1 end
		end
	end
	return groups
end

