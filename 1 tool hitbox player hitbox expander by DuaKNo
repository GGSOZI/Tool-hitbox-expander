	local function clean(t) return (t:gsub("%s%s+", " ")) end
	local function candidates()
		local list = {}
		for _, c in ipairs(ui.cells) do
			if c.click and c.owner and c.owner.tab then
				local t = c.text()
				local low = t:lower()
				local hay = low .. " " .. clean(c.cardTitle or ""):lower() .. " " .. tabNames[c.owner.tab]:lower()
				for _, sy in ipairs(SYN) do
					if low:find(sy[1], 1, true) then hay = hay .. " " .. sy[2] end
				end
				list[#list + 1] = {
					name = t:match("^(.-):") or t, hay = hay, live = true, text = c.text, active = c.active, click = c.click,
					tab = c.owner.tab, frame = c.card, where = tabNames[c.owner.tab] .. " > " .. clean(c.cardTitle or ""),
				}
			end
		end
		for _, f in ipairs(FEATURES) do
			local frame = f.page and f.page.cardFrames[f.title]
			local ftab = f.tab or (f.page and f.page.tab)
			list[#list + 1] = {
				name = f.name, hay = (f.name .. " " .. (f.keys or "")):lower(), live = f.live, text = f.text, active = f.active,
				click = f.click, tab = ftab, frame = frame,
				where = f.where or (tabNames[ftab] .. " > " .. clean(f.title or "")),
			}
		end
		return list
	end

	local function jump(tab, frame)
		if not tab then return end
		showTab(tab)
		if not frame then return end
		task.delay(0.05, function()
			local pg = pages[tab]
			if not (pg and frame.Parent) then return end
			pg.CanvasPosition = Vector2.new(0, math.max(0, frame.AbsolutePosition.Y - pg.AbsolutePosition.Y + pg.CanvasPosition.Y - 4))
			local st = frame:FindFirstChildOfClass("UIStroke")
			if st then
				local oc, ot = st.Color, st.Thickness
				st.Color, st.Thickness = C.accentText, 2
				task.delay(1.2, function()
					if st.Parent then st.Color, st.Thickness = oc, ot end
				end)
			end
		end)
	end

	local function search(q)
		local tokens = {}
		for w in q:lower():gmatch("%S+") do tokens[#tokens + 1] = w end
		local out = {}
		for _, c in ipairs(candidates()) do
			local nameLow = c.name:lower()
			local score, hits = 0, 0
			for _, tk in ipairs(tokens) do
				if nameLow:find(tk, 1, true) then
					hits = hits + 1
					score = score + (nameLow:sub(1, #tk) == tk and 4 or 3)
				elseif c.hay:find(tk, 1, true) then
					hits = hits + 1
					score = score + 1
				end
			end
			c.score, c.hits = score, hits
			if hits == #tokens then out[#out + 1] = c end
		end
		if #out == 0 then
			for _, c in ipairs(candidates()) do
				local score, hits = 0, 0
				local nameLow = c.name:lower()
				for _, tk in ipairs(tokens) do
					if nameLow:find(tk, 1, true) then hits, score = hits + 1, score + 3 elseif c.hay:find(tk, 1, true) then hits, score = hits + 1, score + 1 end
				end
				if hits > 0 then c.score = score out[#out + 1] = c end
			end
		end
		table.sort(out, function(a, b)
			if a.score ~= b.score then return a.score > b.score end
			return a.name < b.name
		end)
		while #out > 8 do table.remove(out) end
		return out
	end

