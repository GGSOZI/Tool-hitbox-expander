-- LAG GUARD: lowers force and visuals when FPS drops, restores them when FPS recovers
K.LAG_FIELDS = { "Radar", "TeleportMode", "ForcePower", "Rapid", "Overlap", "SignalFire", "SnapTool", "FullBody", "EspName", "EspDist", "EspHealth", "Tracers", "HealthBars" }
function H.lagRestore()
	if lag.saved then
		for k, v in pairs(lag.saved) do CONFIG[k] = v end
		lag.saved = nil
	end
	lag.level = 0
	restoreTargets()
end
function H.lagDegrade()
	if not lag.saved then
		lag.saved = {}
		for _, k in ipairs(K.LAG_FIELDS) do lag.saved[k] = CONFIG[k] end
	end
	lag.level = lag.level + 1
	if lag.level == 1 then
		CONFIG.ForcePower = math.min(CONFIG.ForcePower, 2)
		CONFIG.Rapid = false
		CONFIG.SnapTool = false
		CONFIG.Tracers = false
	else
		CONFIG.ForcePower = 1
		CONFIG.Overlap = false
		CONFIG.SignalFire = false
		CONFIG.FullBody = false
		CONFIG.EspName, CONFIG.EspDist, CONFIG.EspHealth, CONFIG.HealthBars = false, false, false, false
		CONFIG.Radar = false
		CONFIG.TeleportMode = false
	end
	restoreTargets()
end
function H.lagStep()
	if not CONFIG.LagGuard then
		if lag.level > 0 then
			H.lagRestore()
			refreshUI()
		end
		return
	end
	local fps = 1 / math.max(avgDt, 0.001)
	if fps < 22 then
		lag.low, lag.high = lag.low + 1, 0
	elseif fps > 45 then
		lag.low, lag.high = 0, lag.high + 1
	else
		lag.low = 0
	end
	if lag.low >= 6 and lag.level < 2 then
		lag.low = 0
		H.lagDegrade()
		showStatus("Lag guard: lowered force (level " .. lag.level .. ")", 4)
		refreshUI()
	elseif lag.high >= 32 and lag.level > 0 then
		lag.high = 0
		H.lagRestore()
		showStatus("Lag guard: restored your settings", 3)
		refreshUI()
	end
end

-- AUTO CLICK: attacks by itself while an enemy is in reach
function H.autoClickStep()
	if not (CONFIG.AutoClick and CONFIG.Enabled) or autoPaused then return end
	if UserInputService:GetFocusedTextBox() then return end
	if CONFIG.HoldMode and not UserInputService:IsKeyDown(CONFIG.HoldKey) then return end
	local ch = player.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local tool = ch:FindFirstChildOfClass("Tool")
	local reach = math.clamp(tool and toolSizeFor(tool) or CONFIG.Size, 6, 60)
	local found = false
	for _, c in ipairs(targetsAround(root.Position, reach, 3, 1)) do
		if matchesPick(c.model) then
			found = true
			break
		end
	end
	if not found then return end
	lastActivate = os.clock()
	pcall(updateTargets)
	actionBurst()
	if tool then
		pcall(function() tool:Activate() end)
	else
		local ok = pcall(function()
			local vu = game:GetService("VirtualUser")
			vu:CaptureController()
			vu:ClickButton1(Vector2.new(0, 0))
		end)
		if not ok and type(mouse1click) == "function" then pcall(mouse1click) end
	end
end

