local function sanitizeConfig()
	CONFIG.Size = math.clamp(CONFIG.Size, CONFIG.MinSize, CONFIG.MaxSize)
	CONFIG.PhysCap = math.clamp(CONFIG.PhysCap, 0, CONFIG.MaxSize)
	if not table.find(K.VISUALS, CONFIG.Visual) then CONFIG.Visual = "Normal" end
	if not table.find(K.FILTERS, CONFIG.TargetFilter) then CONFIG.TargetFilter = "All" end
	CONFIG.TargetSize = math.clamp(CONFIG.TargetSize, 2, 500)
	CONFIG.TargetHeight = math.clamp(CONFIG.TargetHeight, 0, 500)
	CONFIG.NPCSize = math.clamp(CONFIG.NPCSize, 0, 500)
	if not table.find(K.BURSTS, CONFIG.BurstTime) then CONFIG.BurstTime = 1 end
	if not table.find(K.TMODES, CONFIG.TargetMode) then CONFIG.TargetMode = "Auto" end
	if not table.find(K.BODYPARTS, CONFIG.BodyPart) then CONFIG.BodyPart = "Whole" end
	CONFIG.ForcePower = math.clamp(math.floor(CONFIG.ForcePower), 1, 3)
	CONFIG.PanelW = math.clamp(math.floor(CONFIG.PanelW), 200, 480)
	CONFIG.PanelH = math.clamp(math.floor(CONFIG.PanelH), 220, 700)
	if not K.THEMES[CONFIG.Theme] then CONFIG.Theme = "Neon" end
	if not table.find(K.COLOR_NAMES, CONFIG.EnemyColor) then CONFIG.EnemyColor = "Red" end
	if not table.find(K.COLOR_NAMES, CONFIG.ToolColor) then CONFIG.ToolColor = "Blue" end
	if not table.find(K.ESP_COLORS, CONFIG.EspColor) then CONFIG.EspColor = "White" end
	if not table.find(K.TRACER_FROM, CONFIG.TracerFrom) then CONFIG.TracerFrom = "Bottom" end
	if not table.find(K.CLICKGAPS, CONFIG.ClickGap) then CONFIG.ClickGap = 0.2 end
	if not table.find(K.RAYSIZES, CONFIG.RayRadius) then CONFIG.RayRadius = 6 end
	if not table.find(K.ALPHAS, CONFIG.BoxAlpha) then CONFIG.BoxAlpha = 0.75 end
	if not table.find(K.SHAPES, CONFIG.HitShape) then CONFIG.HitShape = "Cube" end
	if not table.find(K.OBJ_MODES, CONFIG.ObjMode) then CONFIG.ObjMode = "Auto" end
	if not table.find(K.OBJ_RANGES, CONFIG.ObjRange) then CONFIG.ObjRange = 60 end
	if not table.find(K.OBJ_WHEN, CONFIG.ObjWhen) then CONFIG.ObjWhen = "Attack" end
	if not table.find(K.COLOR_NAMES, CONFIG.ObjColor) then CONFIG.ObjColor = "Orange" end
	if not table.find(K.RADAR_RANGES, CONFIG.RadarRange) then CONFIG.RadarRange = 100 end
	if not table.find(K.RADAR_SIZES, CONFIG.RadarSize) then CONFIG.RadarSize = 130 end
	if not table.find(K.TELEPORT_DISTS, CONFIG.TeleportDist) then CONFIG.TeleportDist = 6 end
	if not table.find(K.TELEPORT_PARTS, CONFIG.TeleportPart) then CONFIG.TeleportPart = "Root" end
	CONFIG.ObjSize = math.clamp(tonumber(CONFIG.ObjSize) or 14, 2, 300)
	CONFIG.ObjKeywords = tostring(CONFIG.ObjKeywords):sub(1, 300)
	for k, v in pairs(CONFIG.SpyWhite) do
		if type(k) ~= "string" or v ~= true then CONFIG.SpyWhite[k] = nil end
	end
	local rules = {}
	for _, r in ipairs(CONFIG.SpyRules) do
		if type(r) == "table" and type(r.name) == "string" and type(r.expr) == "string" and type(r.idx) == "number" and #rules < 30 then
			rules[#rules + 1] = { name = r.name, idx = math.clamp(math.floor(r.idx), 0, 30), expr = r.expr:sub(1, 200), on = r.on ~= false }
		end
	end
	CONFIG.SpyRules = rules
	local macros = {}
	for _, m in ipairs(CONFIG.SpyMacros) do
		if type(m) == "table" and type(m.name) == "string" and type(m.steps) == "table" and #macros < 30 then
			local steps = {}
			for _, st in ipairs(m.steps) do
				if type(st) == "table" and type(st.code) == "string" and #steps < 200 then
					steps[#steps + 1] = { code = st.code:sub(1, 4000), delay = math.clamp(tonumber(st.delay) or 0, 0, 5) }
				end
			end
			if #steps > 0 then macros[#macros + 1] = { name = m.name:sub(1, 40), steps = steps } end
		end
	end
	CONFIG.SpyMacros = macros
	if not table.find(K.SPY_VIEWS, CONFIG.SpyView) then CONFIG.SpyView = "List" end
	if not table.find(K.SPY_REPEATS, CONFIG.SpyRepeat) then CONFIG.SpyRepeat = 1 end
	CONFIG.SpyW = math.clamp(tonumber(CONFIG.SpyW) or 340, 300, 3000)
	CONFIG.SpyH = math.clamp(tonumber(CONFIG.SpyH) or 440, 400, 3000)
	CONFIG.SpyFont = math.clamp(math.floor(tonumber(CONFIG.SpyFont) or 11), 9, 16)
	for k, v in pairs(CONFIG.SpyBlocked) do
		if type(k) ~= "string" or v ~= true then CONFIG.SpyBlocked[k] = nil end
	end
	for k, v in pairs(CONFIG.SpyExcluded) do
		if type(k) ~= "string" or v ~= true then CONFIG.SpyExcluded[k] = nil end
	end
	for k, v in pairs(CONFIG.ToolSizes) do
		if type(k) ~= "string" or type(v) ~= "number" then CONFIG.ToolSizes[k] = nil else CONFIG.ToolSizes[k] = math.clamp(v, CONFIG.MinSize, CONFIG.MaxSize) end
	end
end

local function loadSettings()
	if not (isfile and readfile) then return end
	pcall(function()
		if isfile(K.SAVE_FILE) then
			local data = HttpService:JSONDecode(readfile(K.SAVE_FILE))
			for _, k in ipairs(K.SAVE_KEYS) do
				if data[k] ~= nil and type(data[k]) == type(CONFIG[k]) then CONFIG[k] = data[k] end
			end
			sanitizeConfig()
		end
	end)
end

local saveQueued = false
local function saveSettings()
	if not writefile or saveQueued then return end
	saveQueued = true
	task.delay(0.5, function()
		saveQueued = false
		pcall(function()
			local data = {}
			for _, k in ipairs(K.SAVE_KEYS) do
				local v = CONFIG[k]
				if lag.saved and lag.saved[k] ~= nil then v = lag.saved[k] end
				data[k] = v
			end
			writefile(K.SAVE_FILE, HttpService:JSONEncode(data))
		end)
	end)
end

