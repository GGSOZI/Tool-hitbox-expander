local function toolSizeFor(tool)
	if CONFIG.PerTool and tool then
		local v = CONFIG.ToolSizes[tool.Name]
		if type(v) == "number" then return v end
	end
	return CONFIG.Size
end

local function physSize(tool)
	local s = toolSizeFor(tool)
	if hasFTI and CONFIG.ForceTouch and CONFIG.PhysCap > 0 then s = math.min(s, CONFIG.PhysCap) end
	return s
end

local function targetSize(tool)
	local s = physSize(tool)
	return Vector3.new(s, s, s)
end

