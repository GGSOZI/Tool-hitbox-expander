local function startProbe()
	if probe then return end
	local ch = player.Character
	if not ch then return end
	local p = { untilT = os.clock() + 4, spawned = {}, touches = {}, conns = {} }
	probe = p
	local function watch(part)
		if part:GetAttribute("HBX_Clone") then return end
		p.conns[#p.conns + 1] = part.Touched:Connect(function(other)
			local model = other:FindFirstAncestorOfClass("Model")
			if model and model ~= ch and model:FindFirstChildOfClass("Humanoid") then
				p.touches[part.Name] = (p.touches[part.Name] or 0) + 1
			end
		end)
	end
	for _, d in ipairs(ch:GetDescendants()) do
		if d:IsA("BasePart") then watch(d) end
	end
	refreshUI()
	showStatus("Test: stand next to an enemy and attack now (4s)...", 4.5)
	task.delay(4.2, function()
		for _, c in ipairs(p.conns) do pcall(function() c:Disconnect() end) end
		local tl, sl = {}, {}
		for name, n in pairs(p.touches) do tl[#tl + 1] = name .. " x" .. n end
		for name, n in pairs(p.spawned) do sl[#sl + 1] = name .. " x" .. n end
		table.sort(tl)
		table.sort(sl)
		local msg
		if #tl > 0 then
			msg = "Test: TOUCH hit via " .. table.concat(tl, ", ") .. ". The expander can work on this move."
		elseif #sl > 0 then
			msg = "Test: the attack spawned " .. table.concat(sl, ", ") .. " but nothing touched an enemy. Try more size / Auto hit."
		else
			msg = "Test: no touches and no spawned parts. If you were next to an enemy, this attack is checked by the game itself (remote / raycast / distance) and part size or touches can't help."
		end
		print("[HitboxExpander] " .. msg)
		probe = nil
		showStatus(msg, 14)
		refreshUI()
	end)
end

local function makeDraggable(handle, target, onTap)
	local dragging, dragInput, dragStart, startPos, moved = false, nil, nil, nil, false
	table.insert(connections, handle.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging, dragInput, moved = true, i, false
			dragStart = i.Position
			startPos = target.Position
			i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End then
					local wasDragging = dragging
					dragging = false
					if wasDragging and not moved and onTap then onTap() end
				end
			end)
		end
	end))
	table.insert(connections, UserInputService.InputChanged:Connect(function(i)
		if not dragging then return end
		local isTouch = dragInput.UserInputType == Enum.UserInputType.Touch
		if (isTouch and i == dragInput) or (not isTouch and i.UserInputType == Enum.UserInputType.MouseMovement) then
			local d = i.Position - dragStart
			if d.Magnitude > 6 then moved = true end
			target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end))
end

local function copyText(text, btn)
	local f = setclipboard or toclipboard
	local ok = f and pcall(f, text)
	local old = btn.Text
	btn.Text = ok and "Copied!" or "No clipboard"
	task.delay(1.2, function() if btn.Parent then btn.Text = old end end)
end

