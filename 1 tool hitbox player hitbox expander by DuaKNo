local function targetsAround(center, radius, maxN, nParts)
	nParts = nParts or 3
	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local cam = workspace.CurrentCamera
	local order = K.BODY_ORDER[CONFIG.BodyPart] or K.BODY_ORDER.Whole
	if lockedModel then
		local lh = lockedModel.Parent and lockedModel:FindFirstChildOfClass("Humanoid")
		if not (lh and lh.Health > 0) then lockedModel = nil end
	end
	local cands = {}
	for hum in pairs(humanoids) do
		local model = hum.Parent
		if not model or not hum:IsDescendantOf(workspace) then
			humanoids[hum] = nil
		elseif model ~= myChar and hum.Health > 0 and (not lockedModel or model == lockedModel) and passesFilter(model) then
			local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
			if root then
				local dist = (root.Position - center).Magnitude
				local ok = dist <= radius + 3
				if ok and not lockedModel then
					if CONFIG.FrontOnly and myRoot then
						local rel = root.Position - myRoot.Position
						if rel.Magnitude > 4 and myRoot.CFrame.LookVector:Dot(rel.Unit) < 0.1 then ok = false end
					end
					if ok and CONFIG.AimAssist and cam then
						local v = root.Position - cam.CFrame.Position
						if v.Magnitude > 1 and cam.CFrame.LookVector:Dot(v.Unit) < 0.92 then ok = false end
					end
				end
				if ok then
					local list = {}
					for _, nm in ipairs(order) do
						local tp = model:FindFirstChild(nm)
						if tp and tp:IsA("BasePart") then
							list[#list + 1] = tp
							if #list >= nParts then break end
						end
					end
					if #list < nParts then
						for _, c in ipairs(model:GetChildren()) do
							if c:IsA("BasePart") and not c:GetAttribute("HBX_Clone") and not table.find(list, c) then
								list[#list + 1] = c
								if #list >= nParts then break end
							end
						end
					end
					if #list > 0 then cands[#cands + 1] = { model = model, list = list, dist = dist } end
				end
			end
		end
	end
	table.sort(cands, function(a, b) return a.dist < b.dist end)
	while #cands > (maxN or 6) do table.remove(cands) end
	return cands
end

local function fireAll(fromParts, targets)
	if CONFIG.HoldMode and not UserInputService:IsKeyDown(CONFIG.HoldKey) then return end
	touchBursts = touchBursts + 1
	if CONFIG.ForcePower >= 2 then
		for _, tp in ipairs(targets) do pcall(function() tp.CanTouch = true end) end
	end
	for _, tp in ipairs(targets) do
		for _, p in ipairs(fromParts) do pcall(firetouchinterest, p, tp, 0) end
	end
	task.wait()
	for _, tp in ipairs(targets) do
		for _, p in ipairs(fromParts) do pcall(firetouchinterest, p, tp, 1) end
	end
end

local function flatten(cands)
	local targets = {}
	for _, c in ipairs(cands) do
		for _, tp in ipairs(c.list) do targets[#targets + 1] = tp end
	end
	return targets
end

local toolPartCache = setmetatable({}, { __mode = "k" })

local function forceTouchOnce(tool)
	local now = os.clock()
	local cache = toolPartCache[tool]
	if not cache or now - cache.t > 1 then
		local list = {}
		for _, d in ipairs(tool:GetDescendants()) do
			if d:IsA("BasePart") and not d:GetAttribute("HBX_Clone") then list[#list + 1] = d end
		end
		table.sort(list, function(a, b) return (a.Name == "Handle" and 1 or 0) > (b.Name == "Handle" and 1 or 0) end)
		cache = { t = now, list = list }
		toolPartCache[tool] = cache
	end
	local P = power()
	local toolParts = {}
	for i = 1, math.min(#cache.list, P.toolParts) do toolParts[i] = cache.list[i] end
	if #toolParts == 0 then return end
	local ch = tool.Parent
	if ch and ch:IsA("Model") then
		for _, nm in ipairs({ "RightHand", "Right Arm" }) do
			local h = ch:FindFirstChild(nm)
			if h and h:IsA("BasePart") then
				toolParts[#toolParts + 1] = h
				break
			end
		end
	end
	local targets = flatten(targetsAround(toolParts[1].Position, toolSizeFor(tool), P.enemies, P.targetParts))
	if #targets == 0 then return end
	fireAll(toolParts, targets)
end

local function forceBurst(tool)
	if not (CONFIG.Enabled and CONFIG.ForceTouch and hasFTI) then return end

	toolUntil[tool] = os.clock() + math.max(0.4, CONFIG.BurstTime)
	if bursting[tool] then return end
	bursting[tool] = true
	task.spawn(function()
		while alive and CONFIG.Enabled and CONFIG.ForceTouch and tool.Parent do
			local now = os.clock()
			if now >= (toolUntil[tool] or 0) and not (heldCount > 0 and now - lastActivate < 8) then break end
			pcall(forceTouchOnce, tool)
			task.wait(touchGap())
		end
		bursting[tool] = nil
	end)
end

local STANDARD = {}
for _, n in ipairs({
	"Head", "Torso", "HumanoidRootPart", "Left Arm", "Right Arm", "Left Leg", "Right Leg", "UpperTorso", "LowerTorso",
	"LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand",
	"LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot",
}) do STANDARD[n] = true end

local function charPartsRaw(ch, cap)
	cap = cap or 5
	local list = {}

	local custom = 0
	for _, c in ipairs(ch:GetChildren()) do
		local p
		if c:IsA("BasePart") and not STANDARD[c.Name] and not c:GetAttribute("HBX_Clone") then
			p = c
		elseif c:IsA("Model") then
			p = c:FindFirstChildWhichIsA("BasePart", true)
		end
		if p then
			list[#list + 1] = p
			custom = custom + 1
			if custom >= 2 then break end
		end
	end

	local tool = ch:FindFirstChildOfClass("Tool")
	if tool then
		local h = tool:FindFirstChild("Handle")
		if h and h:IsA("BasePart") then list[#list + 1] = h end
	end
	for _, nm in ipairs({ "RightHand", "Right Arm", "LeftHand", "Left Arm", "HumanoidRootPart", "RightFoot", "Right Leg", "LeftFoot", "Left Leg" }) do
		local p = ch:FindFirstChild(nm)
		if p and p:IsA("BasePart") then
			list[#list + 1] = p
			if #list >= cap then break end
		end
	end
	return list
end

local charCache = {}

local function charParts(ch, cap)
	cap = cap or 5
	local c = charCache[cap]
	if c and c.ch == ch and #c.list > 0 and os.clock() - c.t < 1 then return c.list end
	local list = charPartsRaw(ch, cap)
	charCache[cap] = { ch = ch, t = os.clock(), list = list }
	return list
end

local registerProjectile

local function actionBurst(manual)
	if not (CONFIG.Enabled and (CONFIG.Moves or manual) and CONFIG.ForceTouch and hasFTI) then return end

	actionUntil = math.max(actionUntil, os.clock() + CONFIG.BurstTime)

	pcall(function()
		local ch = player.Character
		if not ch then return end
		local n = 0
		for _, d in ipairs(ch:GetDescendants()) do
			if d:IsA("BasePart") and not STANDARD[d.Name] and not d:GetAttribute("HBX_Clone")
				and not d:FindFirstAncestorOfClass("Accessory") and not d:FindFirstAncestorOfClass("Tool") then
				registerProjectile(d, CONFIG.BurstTime + 1, true)
				n = n + 1
				if n >= 10 then break end
			end
		end
	end)
	if actionBusy then return end
	actionBusy = true
	task.spawn(function()
		while alive and CONFIG.Enabled and (CONFIG.Moves or manual) and CONFIG.ForceTouch do
			local now = os.clock()
			if now >= actionUntil and not (heldCount > 0 and now - lastActivate < 8) then break end
			pcall(function()
				local ch = player.Character
				local root = ch and ch:FindFirstChild("HumanoidRootPart")
				if not root then return end
				local P = power()
				local mine = charParts(ch, P.toolParts + 2)
				if #mine == 0 then return end
				local targets = flatten(targetsAround(root.Position, CONFIG.Size, math.min(P.enemies, 6), P.targetParts))
				if #targets == 0 then return end
				fireAll(mine, targets)
			end)
			task.wait(touchGap())
		end
		actionBusy = false
	end)
end

local function forceNow()
	if not CONFIG.Enabled then return end
	lastActivate = os.clock()
	actionBurst(true)
	local ch = player.Character
	local tool = ch and ch:FindFirstChildOfClass("Tool")
	if tool then forceBurst(tool) end
end

registerProjectile = function(part, life, noResize)
	if part:GetAttribute("HBX_Clone") then return end
	local rec = projectiles[part]
	if rec then
		rec.exp = math.max(rec.exp, os.clock() + (life or K.PROJECTILE_LIFE))
		return
	end
	local n, oldest, oldestT = 0, nil, math.huge
	for p2, r2 in pairs(projectiles) do
		n = n + 1
		if r2.exp < oldestT then oldest, oldestT = p2, r2.exp end
	end
	if n >= K.PROJECTILE_MAX then
		if oldest then projectiles[oldest] = nil else return end
	end
	rec = { exp = os.clock() + (life or K.PROJECTILE_LIFE), hit = {} }
	projectiles[part] = rec
	if noResize or CONFIG.Safe then return end

	if (not part.CanCollide) or not (hasFTI and CONFIG.ForceTouch) then
		local m = math.min(CONFIG.Size, part.CanCollide and 30 or 60)
		pcall(function()
			local s = part.Size
			rec.orig = s
			rec.sizeUntil = os.clock() + 3
			part.Size = Vector3.new(math.max(s.X, m), math.max(s.Y, m), math.max(s.Z, m))
			part.CanTouch = true
		end)
	end
end

local function projectileStep(part, rec)
	local now = os.clock()
	local touch = {}
	for _, c in ipairs(targetsAround(part.Position, CONFIG.Size, 4, power().targetParts)) do
		if (rec.hit[c.model] or 0) < now then
			rec.hit[c.model] = now + 0.3
			for _, tp in ipairs(c.list) do touch[#touch + 1] = tp end
		end
	end
	if #touch == 0 then return end
	task.spawn(function() fireAll({ part }, touch) end)
end

local function projectileLoop()
	local now = os.clock()
	for part, rec in pairs(projectiles) do
		if rec.orig and part.Parent and now > (rec.sizeUntil or 0) then
			pcall(function() part.Size = rec.orig end)
			rec.orig = nil
		end
		if not part.Parent or now > rec.exp then
			if rec.orig and part.Parent then pcall(function() part.Size = rec.orig end) end
			projectiles[part] = nil
		elseif hasFTI and CONFIG.ForceTouch then
			pcall(projectileStep, part, rec)
		end
	end
end

