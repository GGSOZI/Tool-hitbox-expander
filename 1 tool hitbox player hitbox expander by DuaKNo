-- Smart mode: tries your enabled force methods on each attack and learns which ones cause damage
K.SMART_METHODS = { "Overlap", "SignalFire", "SnapTool", "FullBody" }
local smart = { users = 0, stats = {} }
for _, m in ipairs(K.SMART_METHODS) do smart.stats[m] = { onT = 0, onW = 0, offT = 0, offW = 0 } end
function H.smartP(m)
	local s = smart.stats[m]
	if s.onT >= 4 and s.offT >= 4 then
		return math.clamp(0.5 + (s.onW / s.onT - s.offW / s.offT), 0.1, 0.95)
	end
	return 0.5
end
function H.methodOn(m)
	if not CONFIG[m] then return false end
	if CONFIG.SmartMode and smart.trial then
		local v = smart.trial[m]
		if v ~= nil then return v end
	end
	return true
end
function H.smartBegin()
	if not CONFIG.SmartMode then return false end
	smart.users = smart.users + 1
	if smart.users == 1 then
		local t = {}
		for _, m in ipairs(K.SMART_METHODS) do
			if CONFIG[m] then t[m] = math.random() < H.smartP(m) end
		end
		smart.trial, smart.h0, smart.b0 = t, hitsSeen, touchBursts
	end
	return true
end
function H.smartEnd()
	smart.users = math.max(0, smart.users - 1)
	if smart.users > 0 then return end
	local trial, h0, b0 = smart.trial, smart.h0, smart.b0
	smart.trial = nil
	if not (CONFIG.SmartMode and trial) or touchBursts == b0 then return end
	task.delay(0.4, function()
		local win = hitsSeen > h0
		for m, on in pairs(trial) do
			local s = smart.stats[m]
			if on then
				s.onT = s.onT + 1
				if win then s.onW = s.onW + 1 end
			else
				s.offT = s.offT + 1
				if win then s.offW = s.offW + 1 end
			end
		end
	end)
end
function H.smartReport()
	if not CONFIG.SmartMode then
		return "Smart mode off. When on, it tests your enabled force methods on each attack and keeps using the ones that cause damage."
	end
	local out = {}
	for _, m in ipairs(K.SMART_METHODS) do
		if CONFIG[m] then
			local s = smart.stats[m]
			if s.onT >= 4 and s.offT >= 4 then
				out[#out + 1] = m .. " " .. math.floor(H.smartP(m) * 100) .. "%"
			else
				out[#out + 1] = m .. " learning (" .. (s.onT + s.offT) .. ")"
			end
		end
	end
	return #out > 0 and ("Smart use chance:  " .. table.concat(out, "   ")) or "Smart mode needs at least one force method on (Aim tab)."
end

-- Hitbox shapes (enemy and object boxes) and breakable objects

function H.shapeSize(sz)
	local sh = CONFIG.HitShape
	local m = math.max(sz.X, sz.Y, sz.Z)
	if sh == "Sphere" then
		return Vector3.new(m, m, m)
	elseif sh == "Flat" then
		return Vector3.new(sz.X * 1.3, math.max(2, sz.Y * 0.3), sz.Z * 1.3)
	elseif sh == "Tall" then
		return Vector3.new(math.max(2, sz.X * 0.5), sz.Y * 1.8, math.max(2, sz.Z * 0.5))
	elseif sh == "Wide" then
		return Vector3.new(sz.X * 2, sz.Y, math.max(2, sz.Z * 0.5))
	end
	return sz
end

-- draws the box (or ball) outline for a resized part
function H.syncAdorn(d, part, psz, col, name)
	local want = CONFIG.HitShape == "Sphere" and "SphereHandleAdornment" or "BoxHandleAdornment"
	if d.adorn and (not d.adorn.Parent or d.adorn.ClassName ~= want) then
		pcall(function() d.adorn:Destroy() end)
		d.adorn = nil
	end
	if not d.adorn then
		local a = Instance.new(want)
		a.Name = name
		a.Adornee = part
		a.AlwaysOnTop = false
		a.ZIndex = 1
		a.Parent = part
		d.adorn = a
	end
	if want == "SphereHandleAdornment" then
		d.adorn.Radius = math.max(psz.X, psz.Y, psz.Z) / 2
	else
		d.adorn.Size = psz
	end
	d.adorn.Color3 = col
	d.adorn.Transparency = CONFIG.BoxAlpha
end

