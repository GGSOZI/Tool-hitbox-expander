K.EDGE_PERIOD = 14
local function edgeColor(t)
	local keys = K.EDGE_KEYS
	local n = #keys
	local x = (t / K.EDGE_PERIOD % 1) * n
	local i = math.floor(x)
	local f = x - i
	f = f * f * (3 - 2 * f)
	return keys[i % n + 1]:Lerp(keys[(i + 1) % n + 1], f)
end
