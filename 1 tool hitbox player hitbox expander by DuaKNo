local function lev(a, b)
	local la, lb = #a, #b
	if la == 0 then return lb end
	if lb == 0 then return la end
	local prev, cur = {}, {}
	for j = 0, lb do prev[j] = j end
	for i = 1, la do
		cur[0] = i
		for j = 1, lb do
			local cost = a:byte(i) == b:byte(j) and 0 or 1
			cur[j] = math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost)
		end
		prev, cur = cur, prev
	end
	return prev[lb]
end

-- closest players to what was typed (name or display name), best first
local function playerMatches(q)
	q = q:lower():match("^%s*(.-)%s*$")
	local res = {}
	if q == "" then return res end
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			local n, d = p.Name:lower(), p.DisplayName:lower()
			local score
			if n:sub(1, #q) == q then
				score = 0
			elseif d:sub(1, #q) == q then
				score = 0.5
			elseif n:find(q, 1, true) then
				score = 1
			elseif d:find(q, 1, true) then
				score = 1.5
			elseif #q >= 2 then
				local dist = math.min(lev(q, n:sub(1, #q)), lev(q, d:sub(1, #q)))
				if dist <= math.max(1, math.floor(#q / 3)) then score = 2 + dist end
			end
			if score then res[#res + 1] = { p = p, score = score } end
		end
	end
	table.sort(res, function(a, b)
		if a.score ~= b.score then return a.score < b.score end
		return a.p.Name:lower() < b.p.Name:lower()
	end)
	return res
end

