local function unhookTool(tool)
	local list = hooked[tool]
	if not list then return end
	for _, c in ipairs(list) do pcall(function() c:Disconnect() end) end
	hooked[tool] = nil
	bursting[tool] = nil
end

local function hookTool(tool)
	if hooked[tool] then return end
	local list = {}
	list[1] = tool.Activated:Connect(function()
		lastActivate = os.clock()
		forceBurst(tool)
	end)
	list[2] = tool.Equipped:Connect(function()
		if CONFIG.Enabled then task.defer(function() processTool(tool) end) end
	end)
	list[3] = tool.Unequipped:Connect(function()
		restoreTool(tool)
	end)
	hooked[tool] = list
	for _, c in ipairs(list) do table.insert(connections, c) end
end

processTool = function(tool)
	hookTool(tool)
	if tool.Parent ~= player.Character then return end
	for _, d in ipairs(tool:GetDescendants()) do
		if d:IsA("BasePart") and not d:GetAttribute("HBX_Clone") then expandPart(d) end
	end
end

local function scan()
	local ch = player.Character
	for part, d in pairs(parts) do
		if not part:IsDescendantOf(game) then
			if d.lock then pcall(function() d.lock:Disconnect() end) end
			parts[part] = nil
		else
			local tool = part:FindFirstAncestorOfClass("Tool")
			if tool and tool.Parent ~= ch then restorePart(part, d) end
		end
	end
	local bp = player:FindFirstChildOfClass("Backpack")
	if bp then
		for _, t in ipairs(bp:GetChildren()) do
			if t:IsA("Tool") then hookTool(t) end
		end
	end
	if ch then
		for _, t in ipairs(ch:GetChildren()) do
			if t:IsA("Tool") then processTool(t) end
		end
	end

	for tool in pairs(hooked) do
		if not tool:IsDescendantOf(game) then
			unhookTool(tool)
		elseif tool.Parent == workspace then
			for _, p in ipairs(tool:GetDescendants()) do
				if p:IsA("BasePart") and not p:GetAttribute("HBX_Clone") then
					if parts[p] then restorePart(p, parts[p]) end
					if CONFIG.Throwables and os.clock() - lastActivate <= K.PROJECTILE_WINDOW + 1 then
						registerProjectile(p, 10)
					end
				end
			end
		end
	end
end

local function enforce()
	for part, d in pairs(parts) do
		if part.Parent then
			local sz = targetSize(part:FindFirstAncestorOfClass("Tool"))
			if part.Size ~= sz then
				d.applying = true
				pcall(function() part.Size = sz end)
				d.applying = false
			end
		end
	end
end

K.GUN_WORDS = {
	"gun", "muzzle", "barrel", "shoot", "ammo", "bullet", "pistol", "rifle", "shotgun", "sniper", "smg",
	"revolver", "reload", "magazine", "glock", "firepoint", "fireport",
}
local gunCache = setmetatable({}, { __mode = "k" })

local function nameHasGunWord(name)
	name = string.lower(name)
	for _, w in ipairs(K.GUN_WORDS) do
		if string.find(name, w, 1, true) then return true end
	end
	return false
end

local function looksLikeGun(tool)
	local c = gunCache[tool]
	if c and (c.r or os.clock() - c.t < 3) then return c.r end
	local result = nameHasGunWord(tool.Name)
	if not result then
		local n = 0
		for _, d in ipairs(tool:GetDescendants()) do
			if nameHasGunWord(d.Name) then
				result = true
				break
			end
			n = n + 1
			if n > 300 then break end
		end
	end
	gunCache[tool] = { r = result, t = os.clock() }
	return result
end

local function attackRecent()
	return os.clock() - lastActivate < math.max(1, CONFIG.BurstTime + 0.5)
