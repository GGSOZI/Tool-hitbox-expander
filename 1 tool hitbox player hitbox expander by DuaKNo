-- Network ownership trick: a huge simulation radius makes your client simulate (own) nearby unanchored parts,
-- so touches / Touched events on NPC and enemy parts actually run on your side.
K.SIM_BIG = 1e9
local simOrig = {}
local function setPlayerProp(prop, v)
	if sethiddenproperty then
		local ok = pcall(sethiddenproperty, player, prop, v)
		if ok then return true end
	end
	return (pcall(function() player[prop] = v end))
end
local function applySim(on)
	local ok = false
	if on then
		if simOrig.got == nil then
			simOrig.got = true
			if gethiddenproperty then
				pcall(function() simOrig.Sim = gethiddenproperty(player, "SimulationRadius") end)
			end
			pcall(function() simOrig.Max = player.MaximumSimulationRadius end)
		end
		local a = setPlayerProp("SimulationRadius", K.SIM_BIG)
		local b = setPlayerProp("MaximumSimulationRadius", K.SIM_BIG)
		local c = false
		if type(setsimulationradius) == "function" then c = (pcall(setsimulationradius, K.SIM_BIG, K.SIM_BIG)) end
		ok = a or b or c
	elseif simOrig.got ~= nil then
		setPlayerProp("MaximumSimulationRadius", type(simOrig.Max) == "number" and simOrig.Max or 1000)
		setPlayerProp("SimulationRadius", type(simOrig.Sim) == "number" and simOrig.Sim or 1000)
		simOrig.got = nil
		ok = true
	end
	K.simOK = on and ok or K.simOK
	return ok
end

